  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.0.0",
    "happy-dom": "^20.11.1",
    "pinyin-pro": "3.28.2",
    "polygon-clipping": "^0.15.7",
    "province-city-china": "8.5.8",
    "sharp": "^0.35.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "world-cities-json": "1.0.1"
