{
  "name": "yousa-link",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm generate:assets && astro dev",
    "build": "pnpm clean && pnpm check:map && pnpm generate:assets && astro build && pnpm check:budget",
    "preview": "astro preview",
    "astro": "astro",
    "clean": "node scripts/clean-dist.mjs",
    "generate:assets": "node scripts/generate-stickers.mjs",
    "generate:fonts": "node scripts/generate-fonts.mjs",
    "generate:map": "node scripts/generate-map-data.mjs --write",
    "check:map": "node scripts/generate-map-data.mjs --check",
    "generate:stickers": "node scripts/generate-stickers.mjs",
    "generate:cities": "node scripts/generate-cities.mjs",
