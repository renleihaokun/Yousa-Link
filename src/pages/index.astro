---
import Layout from '../layouts/Layout.astro';
import MapLayer from '../components/Map/MapLayer.astro';
import LocationBadge from '../components/LocationBadge.astro';
import HudPanel from '../components/HUD/HudPanel.astro';
import TrainBanner from '../components/TrainScreen/TrainBanner.astro';
import GalleryPanel from '../components/Gallery/GalleryPanel.astro';
import FatChickenGame from '../components/Game/FatChickenGame.astro';
import AlbumTimeline from '../components/Timeline/AlbumTimeline.astro';
import SceneBlur from '../components/SceneBlur.astro';

---

<Layout>
  <MapLayer />
  <LocationBadge />
  <HudPanel />
  <TrainBanner />
  <GalleryPanel />
  <FatChickenGame />
  <SceneBlur />
  <AlbumTimeline />
</Layout>

<style>
  :global(body) {
    overflow-x: hidden;
  }

  :global(body.panel-open) {
    overflow: hidden;
  }
</style>
