<canvas id="wind-canvas"></canvas>

<script>
  const canvas = document.getElementById('wind-canvas');
  const ctx = canvas.getContext('2d');

  let W, H, CX;

  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
    CX = W / 2;
  }
  resize();
  window.addEventListener('resize', resize);

  function rand(a, b) { return a + Math.random() * (b - a); }

  const MID_T0 = 0.2;
  const MID_T1 = 0.85;
  const MAX_W_RATIO = 0.60;
  const SPRING = 0.012;

  const LAYERS = [
    { speedMul: 1.0, sizeMul: 0.5, count: 3, opacityMul: 0.5 },
    { speedMul: 2.0, sizeMul: 1.0, count: 6, opacityMul: 1.0 },
    { speedMul: 4.0, sizeMul: 1.6, count: 4, opacityMul: 1.3 },
  ];

  const particles = [];

  function spindleT(y) {
    return MID_T0 + (MID_T1 - MID_T0) * Math.max(0, Math.min(1, y / H));
  }

  function targetXFn(lane, t) {
    return CX + lane * MAX_W_RATIO * W * Math.sin(Math.PI * t);
  }

  function createParticle(li) {
    const layer = LAYERS[li];
    const typeRand = Math.random();
    const type = typeRand < 0.4 ? 'line' : typeRand < 0.7 ? 'wind' : 'dust';

    return {
      lane: 0, x: 0, y: 0,
      speed: rand(0.3, 0.6) * layer.speedMul,
      layer: li,
      type,
      width: type === 'line' ? rand(0.6, 1.4) * layer.sizeMul
           : type === 'wind' ? rand(2.5, 5) * layer.sizeMul * 0.6
           : rand(1.2, 3) * layer.sizeMul,
      length: type === 'line' ? rand(60, 150) * layer.sizeMul
            : type === 'wind' ? rand(100, 200) * layer.sizeMul * 0.7
            : 0,
      maxOpacity: rand(0.1, 0.3) * layer.opacityMul,
      phase: rand(0, Math.PI * 2),
    };
  }

  function spawnParticle(p) {
    p.lane = rand(-0.85, 0.85);
    const offY = -rand(30, 100);
    const t = MID_T0 + (MID_T1 - MID_T0) * Math.max(0, offY / H);
    p.x = CX + p.lane * MAX_W_RATIO * W * Math.sin(Math.PI * t);
    p.y = offY;
  }

  for (let li = 0; li < LAYERS.length; li++) {
    for (let i = 0; i < LAYERS[li].count; i++) {
      const p = createParticle(li);
      spawnParticle(p);
      p.y = rand(0, H);
      particles.push(p);
    }
  }

  function updateParticle(p, dt) {
    const t = spindleT(p.y);
    const progress = t - MID_T0 / (MID_T1 - MID_T0);

    const targetX = targetXFn(p.lane, t);
    p.x += (targetX - p.x) * SPRING * dt;

    p.y += p.speed * dt;

    if (p.type === 'wind') {
      p.x += Math.sin(p.y * 0.003 + p.phase) * 0.3 * (0.3 + 0.7 * progress);
    }
    if (p.type === 'dust') {
      p.x += Math.sin(p.y * 0.006 + p.phase + 1.3) * 0.2 * (0.3 + 0.7 * progress);
    }

    if (p.y > H * 1.15 || p.x < -W * 0.6 || p.x > W * 1.6) {
      Object.assign(p, createParticle(p.layer));
      spawnParticle(p);
    }
  }

  function drawParticle(p) {
    const t = spindleT(p.y);
    const progress = (t - MID_T0) / (MID_T1 - MID_T0);

    const fadeIn = Math.min(1, progress / 0.12);
    const fadeOut = Math.max(0, Math.min(1, (1 - progress) / 0.18));
    const opacity = p.maxOpacity * fadeIn * fadeOut;

    if (opacity < 0.003) return;

    const perspective = 0.3 + 0.7 * progress;
    const drawLen = p.length * perspective;
    const drawW = p.width * perspective;

    const targetX = targetXFn(p.lane, t);
    const vx = (targetX - p.x) * SPRING;
    const vy = p.speed;
    const mag = Math.sqrt(vx * vx + vy * vy) || 1;
    const cosA = vy / mag;
    const sinA = vx / mag;

    const tx = p.x - sinA * drawLen;
    const ty = p.y - cosA * drawLen;

    if (p.type === 'dust') {
      ctx.beginPath();
      ctx.arc(p.x, p.y, drawW, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(255, 200, 230, ${opacity * 0.6})`;
      ctx.fill();
      return;
    }

    const gradient = ctx.createLinearGradient(p.x, p.y, tx, ty);

    if (p.type === 'line') {
      gradient.addColorStop(0, `rgba(190, 215, 255, ${opacity})`);
      gradient.addColorStop(0.2, `rgba(190, 215, 255, ${opacity * 0.8})`);
      gradient.addColorStop(0.6, `rgba(200, 190, 255, ${opacity * 0.25})`);
      gradient.addColorStop(1, `rgba(200, 190, 255, 0)`);
    } else {
      gradient.addColorStop(0, `rgba(220, 190, 240, ${opacity * 0.7})`);
      gradient.addColorStop(0.3, `rgba(220, 190, 240, ${opacity * 0.5})`);
      gradient.addColorStop(0.7, `rgba(255, 200, 230, ${opacity * 0.15})`);
      gradient.addColorStop(1, `rgba(255, 200, 230, 0)`);
    }

    ctx.beginPath();
    ctx.moveTo(p.x, p.y);
    ctx.lineTo(tx, ty);
    ctx.strokeStyle = gradient;
    ctx.lineWidth = drawW;
    ctx.lineCap = 'round';
    ctx.stroke();
  }

  let lastTime = 0;

  function animate(time) {
    const dt = Math.min(time - lastTime, 50);
    lastTime = time;

    ctx.clearRect(0, 0, W, H);

    for (const p of particles) {
      updateParticle(p, dt);
      drawParticle(p);
    }

    requestAnimationFrame(animate);
  }

  requestAnimationFrame(animate);
</script>

<style>
  #wind-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 1;
  }
</style>
