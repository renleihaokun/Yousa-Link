---
---

<div id="map-container" class="map-container">
  <div id="map-chart" class="map-chart"></div>
</div>

<script>
  import * as echarts from 'echarts';

  const cities = [
    { name: '成都', value: [104.0668, 30.5728] },
    { name: '北京', value: [116.4074, 39.9042] },
    { name: '杭州', value: [120.1551, 30.2741] },
    { name: '广州', value: [113.2644, 23.1291] },
    { name: '厦门', value: [118.0894, 24.4798] },
    { name: '武汉', value: [114.3055, 30.5928] },
    { name: '上海', value: [121.4737, 31.2304] }
  ];

  const tourRoutes = [
    { from: [104.0668, 30.5728], to: [116.4074, 39.9042] },
    { from: [116.4074, 39.9042], to: [120.1551, 30.2741] },
    { from: [120.1551, 30.2741], to: [113.2644, 23.1291] },
    { from: [113.2644, 23.1291], to: [118.0894, 24.4798] },
    { from: [118.0894, 24.4798], to: [114.3055, 30.5928] },
    { from: [114.3055, 30.5928], to: [121.4737, 31.2304] }
  ];

  const PROVINCE_COLORS = [
    '#222222', '#252525', '#282828', '#2b2b2b', '#2e2e2e',
    '#313131', '#232323', '#262626', '#292929', '#2c2c2c',
    '#2f2f2f', '#242424', '#272727', '#2a2a2a', '#2d2d2d',
    '#303030', '#212121', '#323232', '#333333', '#202020',
    '#2e2e2e', '#262626', '#2a2a2a', '#222222', '#2c2c2c',
    '#242424', '#282828', '#303030', '#2f2f2f', '#272727',
    '#2b2b2b', '#232223', '#292929', '#313131'
  ];

  const CENTER: [number, number] = [109, 33];
  const INIT_ZOOM = 5;
  const BOUNDS = { lngMin: 60, lngMax: 145, latMin: 10, latMax: 60 };

  async function initMap() {
    const [neighborsRes, chinaRes] = await Promise.all([
      fetch('/neighbors.geo.json'),
      fetch('https://geo.datav.aliyun.com/areas_v3/bound/100000_full.json')
    ]);
    const neighborsGeo = await neighborsRes.json();
    const chinaGeo = await chinaRes.json();

    // Merge into one GeoJSON: neighbors (without China) + China provinces
    const neighborFeatures = neighborsGeo.features.filter(
      (f: any) => f.properties.name !== 'China'
    );
    const merged = {
      type: 'FeatureCollection' as const,
      features: [...neighborFeatures, ...chinaGeo.features]
    };
    echarts.registerMap('world', merged);

    const regionStyles = merged.features.map((f: any, i: number) => {
      const isNeighbor = i < neighborFeatures.length;
      return {
        name: f.properties.name,
        itemStyle: {
          areaColor: isNeighbor ? '#0e0e0e' : PROVINCE_COLORS[(i - neighborFeatures.length) % PROVINCE_COLORS.length],
          borderColor: isNeighbor
            ? 'rgba(255,255,255,0.04)'
            : 'rgba(255, 105, 180, 0.2)',
          borderWidth: isNeighbor ? 0.5 : 0.8,
          shadowColor: isNeighbor ? 'transparent' : 'rgba(255, 105, 180, 0.15)',
          shadowBlur: isNeighbor ? 0 : 6
        }
      };
    });

    const routeLines = tourRoutes.map(route => ({
      coords: [route.from, route.to]
    }));

    const chartDom = document.getElementById('map-chart')!;
    const mainChart = echarts.init(chartDom);

    mainChart.setOption({
      backgroundColor: 'transparent',
      geo: {
        map: 'world',
        roam: 'move',
        zoom: INIT_ZOOM,
        center: CENTER,
        label: { show: false, color: '#B5E8F7' },
        emphasis: {
          disabled: false,
          label: {
            show: true,
            color: '#B5E8F7',
            fontSize: 12
          },
          itemStyle: {
            areaColor: '#3a3a3a',
            borderColor: 'rgba(255, 105, 180, 0.5)',
            shadowBlur: 12
          }
        },
        select: { disabled: true },
        regions: regionStyles
      },
      series: [
        {
          type: 'lines',
          coordinateSystem: 'geo',
          clip: false,
          z: 1,
          effect: {
            show: true,
            period: 4,
            trailLength: 0.4,
            symbol: 'arrow',
            symbolSize: 6,
            color: '#FF69B4'
          },
          lineStyle: {
            color: 'rgba(255, 105, 180, 0.5)',
            width: 2,
            curveness: 0.2
          },
          data: routeLines
        },
        {
          type: 'effectScatter',
          coordinateSystem: 'geo',
          clip: false,
          z: 2,
          symbol: 'circle',
          symbolSize: 10,
          showEffectOn: 'render',
          rippleEffect: {
            brushType: 'stroke',
            scale: 4,
            period: 3,
            number: 2
          },
          itemStyle: {
            color: '#FF69B4',
            shadowBlur: 20,
            shadowColor: 'rgba(255, 105, 180, 0.8)'
          },
          label: {
            show: true,
            position: 'right',
            formatter: '{b}',
            color: '#ccc',
            fontSize: 12,
            textShadowColor: 'rgba(0,0,0,0.8)',
            textShadowBlur: 4
          },
          data: cities
        }
      ]
    });

    mainChart.on('georoam', () => {
      const geoModel = (mainChart as any).getModel().getComponentModel('geo');
      const coordSys = geoModel?.coordinateSystem;
      if (!coordSys) return;

      const cz = coordSys.getCenter();
      const z = coordSys.getZoom();
      const halfLng = 90 / z;
      const halfLat = 50 / z;

      const clampedLng = Math.max(BOUNDS.lngMin + halfLng, Math.min(BOUNDS.lngMax - halfLng, cz[0]));
      const clampedLat = Math.max(BOUNDS.latMin + halfLat, Math.min(BOUNDS.latMax - halfLat, cz[1]));

      if (clampedLng !== cz[0] || clampedLat !== cz[1]) {
        coordSys.setCenter([clampedLng, clampedLat]);
        geoModel.setCenter([clampedLng, clampedLat]);
        (mainChart as any).updateTransform();
      }
    });

    window.addEventListener('resize', () => mainChart.resize());

    startGroundStream();

    function startGroundStream() {
      // === 持续微颤（全程叠加，不规则自然抖动） ===
      const MICRO_AX = [2.0, 1.5];     // X 幅度 (px)
      const MICRO_FX = [3.1, 5.7];     // X 频率 (Hz)
      const MICRO_PX = [0, 1.3];       // X 相位
      const MICRO_AY = [1.5, 1.0];     // Y 幅度 (px)
      const MICRO_FY = [2.9, 7.3];     // Y 频率 (Hz)
      const MICRO_PY = [2.1, 0.5];     // Y 相位
      const MICRO_R_AMP = 0.3;         // 旋转幅度 (°)
      const MICRO_R_FREQ = 1.7;        // 旋转频率 (Hz)

      // === 漂移（缓慢下移） ===
      const DRIFT_AMP = 35;            // 最大下漂 (px)
      const DRIFT_MIN = 10000;          // 最小漂移时长 (ms)
      const DRIFT_RANGE = 2000;        // 时长随机范围
      const WINDUP_START = 0.5;        // 起风起始进度（50% 后微颤放大）
      const WINDUP_MAX = 6;            // 微颤最大放大倍数（更强，桥接湍流）

      // === 湍流（复位 + 大幅振荡 + 旋转摇晃） ===
      const TURB_AMP_X = 50;           // 水平摆幅 (px)
      const TURB_AMP_Y = 35;           // 垂直摆幅 (px)
      const TURB_AMP_R = 6;            // 旋转幅度 (°)
      const TURB_FREQ = 1.8;           // 全程振荡次数
      const TURB_DECAY = 0.7;          // 衰减系数
      const TURB_MIN = 3000;           // 最小湍流时长 (ms)
      const TURB_RANGE = 1500;         // 时长随机范围
      const TURB_FADE_IN = 500;        // 湍流淡入时长 (ms)
      const TURB_FADE_OUT_R = 0.2;     // 末尾淡出比例

      let phase: 'drift' | 'turbulence' = 'drift';
      let phaseStart = performance.now();
      let curDriftDuration = DRIFT_MIN + Math.random() * DRIFT_RANGE;
      let curTurbDuration = TURB_MIN + Math.random() * TURB_RANGE;
      let microScale = 1;

      function tick(time: number) {
        requestAnimationFrame(tick);
        const ms = time / 1000;
        const elapsed = time - phaseStart;

        // 微颤放大 —— 漂移期后段起风，湍流期保持高幅度再缓慢退去
        let targetScale = 1;
        if (phase === 'drift') {
          const progress = Math.min(elapsed / curDriftDuration, 1);
          if (progress > WINDUP_START) {
            const p = (progress - WINDUP_START) / (1 - WINDUP_START);
            targetScale = 1 + (WINDUP_MAX - 1) * p;
          }
        } else if (elapsed < TURB_FADE_IN) {
          targetScale = WINDUP_MAX;
        } else {
          const p = Math.min((elapsed - TURB_FADE_IN) / 1000, 1);
          targetScale = WINDUP_MAX + (1 - WINDUP_MAX) * p;
        }
        microScale += (targetScale - microScale) * (phase === 'drift' ? 0.08 : 0.12);

        const microX = (MICRO_AX[0] * Math.sin(ms * MICRO_FX[0] + MICRO_PX[0])
                     +  MICRO_AX[1] * Math.sin(ms * MICRO_FX[1] + MICRO_PX[1])) * microScale;
        const microY = (MICRO_AY[0] * Math.sin(ms * MICRO_FY[0] + MICRO_PY[0])
                     +  MICRO_AY[1] * Math.sin(ms * MICRO_FY[1] + MICRO_PY[1])) * microScale;
        const microR = MICRO_R_AMP * microScale * Math.sin(ms * MICRO_R_FREQ);

        if (phase === 'drift') {
          const progress = Math.min(elapsed / curDriftDuration, 1);
          const driftY = DRIFT_AMP * (1 - Math.pow(1 - progress, 3));

          chartDom.style.transform =
            `translate(${microX}px, ${microY + driftY}px) rotate(${microR}deg)`;

          if (progress >= 1) {
            phase = 'turbulence';
            phaseStart = time;
            curTurbDuration = TURB_MIN + Math.random() * TURB_RANGE;
            window.dispatchEvent(new CustomEvent('flight-turbulence'));
          }
        } else {
          const progress = Math.min(elapsed / curTurbDuration, 1);
          const decay = Math.exp(-progress * TURB_DECAY * TURB_FREQ * 2);
          const angle = progress * TURB_FREQ * 2 * Math.PI;

          // 淡入：线性，从第一帧起平稳增长
          const fadeIn = Math.min(elapsed, TURB_FADE_IN) / TURB_FADE_IN;

          // 淡出：最后 20% 平滑归零
          const endFade = progress >= 1 - TURB_FADE_OUT_R
            ? (1 - progress) / TURB_FADE_OUT_R
            : 1;

          // 漂移平滑归零（复位），与漂移期终点连续
          const resetY = DRIFT_AMP * Math.pow(1 - progress, 3);

          // 湍流阻尼振荡 —— 多频叠加避免规律感
          const turbX = TURB_AMP_X * decay * fadeIn * endFade
            * (Math.sin(angle) + 0.4 * Math.sin(angle * 2.1 + 1.2));
          const turbY = TURB_AMP_Y * decay * fadeIn * endFade
            * (Math.sin(angle * 0.9 + 0.7) + 0.3 * Math.sin(angle * 2.8 + 0.4));
          const turbR = TURB_AMP_R * decay * fadeIn * endFade
            * (Math.sin(angle * 0.7 + 1.1) + 0.5 * Math.sin(angle * 2.4));

          chartDom.style.transform =
            `translate(${microX + turbX}px, ${microY + turbY + resetY}px) rotate(${microR + turbR}deg)`;

          if (progress >= 1) {
            phase = 'drift';
            phaseStart = time;
            curDriftDuration = DRIFT_MIN + Math.random() * DRIFT_RANGE;
            window.dispatchEvent(new CustomEvent('flight-turbulence-end'));
          }
        }
      }

      requestAnimationFrame(tick);
    }
  }

  initMap();
</script>

<style>
  .map-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    background: #000;
  }

  .map-chart {
    width: 100%;
    height: 100%;
    cursor: grab;
  }

  .map-chart:active {
    cursor: grabbing;
  }


</style>
