---
import { getTourCities, getTourRoutes } from '../../domain/tours';

const mapCities = getTourCities();
const mapRoutes = getTourRoutes();
---

<div
  id="map-container"
  class="map-container"
  data-cities={JSON.stringify(mapCities)}
  data-routes={JSON.stringify(mapRoutes)}
>
  <div id="map-chart" class="map-chart"></div>
  <p class="map-disclaimer">
    <span class="disclaimer-desktop">完整地图，可拖拽探索</span>
    <span class="disclaimer-mobile">完整地图<br>切换至桌面端<br>可拖拽浏览</span>
  </p>
</div>

<script>
  // 主题蓝色值
  const THEME_BLUE = '#a4d3eb';
  const MAP_NAME = 'tour-region';

  const PROVINCE_COLORS = [
    '#222222', '#252525', '#282828', '#2b2b2b', '#2e2e2e',
    '#313131', '#232323', '#262626', '#292929', '#2c2c2c',
    '#2f2f2f', '#242424', '#272727', '#2a2a2a', '#2d2d2d',
    '#303030', '#212121', '#323232', '#333333', '#202020',
    '#2e2e2e', '#262626', '#2a2a2a', '#222222', '#2c2c2c',
    '#242424', '#282828', '#303030', '#2f2f2f', '#272727',
    '#2b2b2b', '#232223', '#292929', '#313131'
  ];

  const CENTER: [number, number] = [109, 33];
  const INIT_ZOOM = 5;
  const BOUNDS = { lngMin: 60, lngMax: 145, latMin: 10, latMax: 60 };

  async function initMap() {
    const container = document.getElementById('map-container');
    const cities = JSON.parse(container?.dataset.cities || '[]');
    const tourRoutes = JSON.parse(container?.dataset.routes || '[]');
    const [echarts, mapResponse] = await Promise.all([
      import('../../scripts/map-echarts'),
      fetch('/tour-map.geo.json')
    ]);
    if (!mapResponse.ok) throw new Error(`Map request failed: ${mapResponse.status}`);
    const merged = await mapResponse.json();
    const neighborCount = merged.features.findIndex((feature: any) =>
      typeof feature.properties?.adcode === 'number'
    );
    echarts.registerMap(MAP_NAME, merged);

    const regionStyles = merged.features.map((f: any, i: number) => {
      const isNeighbor = i < neighborCount;
      return {
        name: f.properties.name,
        itemStyle: {
          areaColor: isNeighbor ? '#0e0e0e' : PROVINCE_COLORS[(i - neighborCount) % PROVINCE_COLORS.length],
          borderColor: isNeighbor
            ? 'rgba(255,255,255,0.04)'
            : 'rgba(255, 105, 180, 0.2)',
          borderWidth: isNeighbor ? 0.5 : 0.8,
          shadowColor: isNeighbor ? 'transparent' : 'rgba(255, 105, 180, 0.15)',
          shadowBlur: isNeighbor ? 0 : 6
        }
      };
    });

    const routeLines = tourRoutes.map(route => ({
      coords: [route.from, route.to]
    }));

    const chartDom = document.getElementById('map-chart')!;
    const mainChart = echarts.init(chartDom);

    let isPhone = window.matchMedia('(max-width: 767px)').matches;

    const getViewportProfile = () => ({
      center: isPhone ? [112.2, 36] : CENTER,
      zoom: isPhone ? 11 : INIT_ZOOM,
      roam: isPhone ? false : 'move',
      symbolSize: isPhone ? 8 : 10,
      labelSize: isPhone ? 10 : 12
    });

    const profile = getViewportProfile();

    mainChart.setOption({
      backgroundColor: 'transparent',
      geo: {
        map: MAP_NAME,
        roam: profile.roam,
        zoom: profile.zoom,
        center: profile.center,
        label: { show: false, color: THEME_BLUE },
        emphasis: {
          disabled: false,
          label: {
            show: true,
            color: THEME_BLUE,
            fontSize: profile.labelSize
          },
          itemStyle: {
            areaColor: '#3a3a3a',
            borderColor: 'rgba(255, 105, 180, 0.5)',
            shadowBlur: 12
          }
        },
        select: { disabled: true },
        regions: regionStyles
      },
      series: [
        {
          type: 'lines',
          coordinateSystem: 'geo',
          clip: false,
          z: 1,
          effect: {
            show: true,
            period: 4,
            trailLength: 0.4,
            symbol: 'arrow',
            symbolSize: 6,
            color: '#ea95b3'
          },
          lineStyle: {
            color: 'rgba(234, 149, 179, 0.5)',
            width: 2,
            curveness: 0.2
          },
          data: routeLines
        },
        {
          type: 'effectScatter',
          coordinateSystem: 'geo',
          clip: false,
          z: 2,
          symbol: 'circle',
          symbolSize: profile.symbolSize,
          showEffectOn: 'render',
          rippleEffect: {
            brushType: 'stroke',
            scale: 4,
            period: 3,
            number: 2
          },
          itemStyle: {
            color: '#ea95b3',
            shadowBlur: 20,
            shadowColor: 'rgba(234, 149, 179, 0.8)'
          },
          label: {
            show: true,
            position: 'right',
            formatter: '{b}',
            color: '#ccc',
            fontSize: profile.labelSize,
            textShadowColor: 'rgba(0,0,0,0.8)',
            textShadowBlur: 4
          },
          data: cities
        }
      ]
    });

    mainChart.on('georoam', () => {
      const geoModel = (mainChart as any).getModel().getComponentModel('geo');
      const coordSys = geoModel?.coordinateSystem;
      if (!coordSys) return;

      const cz = coordSys.getCenter();
      const z = coordSys.getZoom();
      const halfLng = 90 / z;
      const halfLat = 50 / z;

      const clampedLng = Math.max(BOUNDS.lngMin + halfLng, Math.min(BOUNDS.lngMax - halfLng, cz[0]));
      const clampedLat = Math.max(BOUNDS.latMin + halfLat, Math.min(BOUNDS.latMax - halfLat, cz[1]));

      if (clampedLng !== cz[0] || clampedLat !== cz[1]) {
        coordSys.setCenter([clampedLng, clampedLat]);
        geoModel.setCenter([clampedLng, clampedLat]);
        (mainChart as any).updateTransform();
      }
    });

    let resizeFrame = 0;
    const handleResize = () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(() => {
        mainChart.resize();
        const nextIsPhone = window.matchMedia('(max-width: 767px)').matches;
        if (nextIsPhone === isPhone) return;
        isPhone = nextIsPhone;
        const nextProfile = getViewportProfile();
        mainChart.setOption({
          geo: {
            roam: nextProfile.roam,
            zoom: nextProfile.zoom,
            center: nextProfile.center,
            emphasis: { label: { fontSize: nextProfile.labelSize } }
          },
          series: [
            {},
            { symbolSize: nextProfile.symbolSize, label: { fontSize: nextProfile.labelSize } }
          ]
        });
      });
    };
    const handleVisibility = () => {
      const animation = mainChart.getZr().animation;
      if (document.hidden) animation.pause();
      else animation.resume();
    };
    const cleanup = () => {
      cancelAnimationFrame(resizeFrame);
      window.removeEventListener('resize', handleResize);
      document.removeEventListener('visibilitychange', handleVisibility);
      mainChart.dispose();
    };
    window.addEventListener('resize', handleResize);
    document.addEventListener('visibilitychange', handleVisibility);
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }

  initMap().catch((error) => console.error(error));
</script>

<style>
  .map-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    z-index: 0;
    background: #000;
    overflow: hidden;
  }

  .map-chart {
    position: absolute;
    top: -6vh;
    left: -6vw;
    width: 112vw;
    height: 112vh;
    height: 112dvh;
    cursor: grab;
    transform-origin: center;
    backface-visibility: hidden;
  }

  .map-chart:active {
    cursor: grabbing;
  }

@media (max-width: 767px) {
  .map-chart {
    pointer-events: none;
    cursor: default;
  }

  .disclaimer-desktop {
    display: none;
  }
}

.map-disclaimer {
  position: absolute;
  right: 16px;
  bottom: 18px;
  z-index: 5;
  font-size: 13px;
  color: var(--color-blue-80);
  opacity: 0.6;
  letter-spacing: 0.6px;
  user-select: none;
  pointer-events: none;
  line-height: 1.5;
  text-align: right;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  margin: 0;
  max-width: 260px;
}

.disclaimer-mobile {
  display: none;
}

@media (max-width: 767px) {
  .map-disclaimer {
    right: 10px;
    bottom: max(12px, calc(var(--safe-bottom, 16px)));
    font-size: 12px;
    opacity: 0.5;
    max-width: 130px;
    text-align: right;
  }

  .disclaimer-mobile {
    display: inline;
  }
}


</style>
