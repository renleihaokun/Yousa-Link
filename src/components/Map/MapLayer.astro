---
---

<div id="map-container" class="map-container">
  <div id="map-chart" class="map-chart"></div>
</div>

<script>
  import * as echarts from 'echarts';
  import { config } from '../../config';

  const cities = [
    { name: '成都', value: [104.0668, 30.5728] },
    { name: '北京', value: [116.4074, 39.9042] },
    { name: '杭州', value: [120.1551, 30.2741] },
    { name: '广州', value: [113.2644, 23.1291] },
    { name: '厦门', value: [118.0894, 24.4798] },
    { name: '武汉', value: [114.3055, 30.5928] },
    { name: '上海', value: [121.4737, 31.2304] }
  ];

  const tourRoutes = [
    { from: [104.0668, 30.5728], to: [116.4074, 39.9042] },
    { from: [116.4074, 39.9042], to: [120.1551, 30.2741] },
    { from: [120.1551, 30.2741], to: [113.2644, 23.1291] },
    { from: [113.2644, 23.1291], to: [118.0894, 24.4798] },
    { from: [118.0894, 24.4798], to: [114.3055, 30.5928] },
    { from: [114.3055, 30.5928], to: [121.4737, 31.2304] }
  ];

  const PROVINCE_COLORS = [
    '#222222', '#252525', '#282828', '#2b2b2b', '#2e2e2e',
    '#313131', '#232323', '#262626', '#292929', '#2c2c2c',
    '#2f2f2f', '#242424', '#272727', '#2a2a2a', '#2d2d2d',
    '#303030', '#212121', '#323232', '#333333', '#202020',
    '#2e2e2e', '#262626', '#2a2a2a', '#222222', '#2c2c2c',
    '#242424', '#282828', '#303030', '#2f2f2f', '#272727',
    '#2b2b2b', '#232223', '#292929', '#313131'
  ];

  const CENTER: [number, number] = [109, 33];
  const INIT_ZOOM = 5;
  const BOUNDS = { lngMin: 60, lngMax: 145, latMin: 10, latMax: 60 };

  async function initMap() {
    const [neighborsRes, chinaRes] = await Promise.all([
      fetch('/neighbors.geo.json'),
      fetch('/china.geo.json')
    ]);
    const neighborsGeo = await neighborsRes.json();
    const chinaGeo = await chinaRes.json();

    // Merge into one GeoJSON: neighbors (without China) + China provinces
    const neighborFeatures = neighborsGeo.features.filter(
      (f: any) => f.properties.name !== 'China'
    );
    const merged = {
      type: 'FeatureCollection' as const,
      features: [...neighborFeatures, ...chinaGeo.features]
    };
    echarts.registerMap('world', merged);

    const regionStyles = merged.features.map((f: any, i: number) => {
      const isNeighbor = i < neighborFeatures.length;
      return {
        name: f.properties.name,
        itemStyle: {
          areaColor: isNeighbor ? '#0e0e0e' : PROVINCE_COLORS[(i - neighborFeatures.length) % PROVINCE_COLORS.length],
          borderColor: isNeighbor
            ? 'rgba(255,255,255,0.04)'
            : 'rgba(255, 105, 180, 0.2)',
          borderWidth: isNeighbor ? 0.5 : 0.8,
          shadowColor: isNeighbor ? 'transparent' : 'rgba(255, 105, 180, 0.15)',
          shadowBlur: isNeighbor ? 0 : 6
        }
      };
    });

    const routeLines = tourRoutes.map(route => ({
      coords: [route.from, route.to]
    }));

    const chartDom = document.getElementById('map-chart')!;
    const mainChart = echarts.init(chartDom);

    mainChart.setOption({
      backgroundColor: 'transparent',
      geo: {
        map: 'world',
        roam: 'move',
        zoom: INIT_ZOOM,
        center: CENTER,
        label: { show: false, color: '#B5E8F7' },
        emphasis: {
          disabled: false,
          label: {
            show: true,
            color: '#B5E8F7',
            fontSize: 12
          },
          itemStyle: {
            areaColor: '#3a3a3a',
            borderColor: 'rgba(255, 105, 180, 0.5)',
            shadowBlur: 12
          }
        },
        select: { disabled: true },
        regions: regionStyles
      },
      series: [
        {
          type: 'lines',
          coordinateSystem: 'geo',
          clip: false,
          z: 1,
          effect: {
            show: true,
            period: 4,
            trailLength: 0.4,
            symbol: 'arrow',
            symbolSize: 6,
            color: '#FF69B4'
          },
          lineStyle: {
            color: 'rgba(255, 105, 180, 0.5)',
            width: 2,
            curveness: 0.2
          },
          data: routeLines
        },
        {
          type: 'effectScatter',
          coordinateSystem: 'geo',
          clip: false,
          z: 2,
          symbol: 'circle',
          symbolSize: 10,
          showEffectOn: 'render',
          rippleEffect: {
            brushType: 'stroke',
            scale: 4,
            period: 3,
            number: 2
          },
          itemStyle: {
            color: '#FF69B4',
            shadowBlur: 20,
            shadowColor: 'rgba(255, 105, 180, 0.8)'
          },
          label: {
            show: true,
            position: 'right',
            formatter: '{b}',
            color: '#ccc',
            fontSize: 12,
            textShadowColor: 'rgba(0,0,0,0.8)',
            textShadowBlur: 4
          },
          data: cities
        }
      ]
    });

    mainChart.on('georoam', () => {
      const geoModel = (mainChart as any).getModel().getComponentModel('geo');
      const coordSys = geoModel?.coordinateSystem;
      if (!coordSys) return;

      const cz = coordSys.getCenter();
      const z = coordSys.getZoom();
      const halfLng = 90 / z;
      const halfLat = 50 / z;

      const clampedLng = Math.max(BOUNDS.lngMin + halfLng, Math.min(BOUNDS.lngMax - halfLng, cz[0]));
      const clampedLat = Math.max(BOUNDS.latMin + halfLat, Math.min(BOUNDS.latMax - halfLat, cz[1]));

      if (clampedLng !== cz[0] || clampedLat !== cz[1]) {
        coordSys.setCenter([clampedLng, clampedLat]);
        geoModel.setCenter([clampedLng, clampedLat]);
        (mainChart as any).updateTransform();
      }
    });

    window.addEventListener('resize', () => mainChart.resize());

    if (config.effects.mapShake) {
      startGroundStream();
    }

    function startGroundStream() {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (reducedMotion.matches) return;

      const TAU = Math.PI * 2;
      const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
      const smootherstep = (v: number) => {
        const t = clamp01(v);
        return t * t * t * (t * (t * 6 - 15) + 10);
      };

      // === 持续微颤：保持小幅、较高频，作为全程气流底噪 ===
      const MICRO_AX = [1.3, 0.8];
      const MICRO_FX = [0.62, 1.18];   // cycles per second
      const MICRO_PX = [0, 1.3];
      const MICRO_AY = [1.0, 0.7];
      const MICRO_FY = [0.58, 1.35];
      const MICRO_PY = [2.1, 0.5];
      const MICRO_R_AMP = 0.18;
      const MICRO_R_FREQ = 0.42;

      // === 漂移：慢慢偏离视窗，后段只轻微抬高抖动能量 ===
      const DRIFT_AMP = 28;
      const DRIFT_MIN = 11000;
      const DRIFT_RANGE = 3000;
      const WINDUP_START = 0.58;
      const WINDUP_MAX = 2.35;

      // === 归位：用温和晃动遮住地图回到原点，不做明显“强气流演出” ===
      const RECOVER_MIN = 5200;
      const RECOVER_RANGE = 1800;
      const RECOVER_SHAKE = 1.15;

      type MotionPhase = 'drift' | 'recover';

      let phase: MotionPhase = 'drift';
      let phaseStart = performance.now();
      let curDriftDuration = DRIFT_MIN + Math.random() * DRIFT_RANGE;
      let curRecoverDuration = RECOVER_MIN + Math.random() * RECOVER_RANGE;
      let microScale = 1;
      let rafId = 0;
      let currentX = 0;
      let currentY = 0;
      let currentR = 0;

      function microMotion(seconds: number, scale: number) {
        const x = (MICRO_AX[0] * Math.sin(seconds * TAU * MICRO_FX[0] + MICRO_PX[0])
                + MICRO_AX[1] * Math.sin(seconds * TAU * MICRO_FX[1] + MICRO_PX[1])) * scale;
        const y = (MICRO_AY[0] * Math.sin(seconds * TAU * MICRO_FY[0] + MICRO_PY[0])
                + MICRO_AY[1] * Math.sin(seconds * TAU * MICRO_FY[1] + MICRO_PY[1])) * scale;
        const r = MICRO_R_AMP * scale * Math.sin(seconds * TAU * MICRO_R_FREQ);
        return { x, y, r };
      }

      function coverWobble(seconds: number, amount: number) {
        return {
          x: amount * (3.2 * Math.sin(seconds * TAU * 0.34 + 0.4)
            + 1.4 * Math.sin(seconds * TAU * 0.77 + 2.6)),
          y: amount * (2.1 * Math.sin(seconds * TAU * 0.41 + 2.2)
            + 0.9 * Math.sin(seconds * TAU * 0.88 + 0.7)),
          r: amount * (0.34 * Math.sin(seconds * TAU * 0.27 + 1.1)
            + 0.16 * Math.sin(seconds * TAU * 0.63 + 2.8))
        };
      }

      function tick(time: number) {
        rafId = requestAnimationFrame(tick);
        const ms = time / 1000;
        const elapsed = time - phaseStart;

        // 微颤能量：只做背景增强，用来遮住归位，不制造强烈事件感。
        let targetScale = 1;
        if (phase === 'drift') {
          const progress = Math.min(elapsed / curDriftDuration, 1);
          if (progress > WINDUP_START) {
            const p = smootherstep((progress - WINDUP_START) / (1 - WINDUP_START));
            targetScale = 1 + (WINDUP_MAX - 1) * p;
          }
        } else {
          const progress = Math.min(elapsed / curRecoverDuration, 1);
          const p = smootherstep(progress);
          targetScale = WINDUP_MAX + (1 - WINDUP_MAX) * p;
        }
        microScale += (targetScale - microScale) * 0.07;

        const micro = microMotion(ms, microScale);
        let targetX = micro.x;
        let targetY = micro.y;
        let targetR = micro.r;

        if (phase === 'drift') {
          const progress = Math.min(elapsed / curDriftDuration, 1);
          const driftY = DRIFT_AMP * smootherstep(progress);
          const pressure = smootherstep((progress - WINDUP_START) / (1 - WINDUP_START));
          const cover = coverWobble(ms, pressure * RECOVER_SHAKE);

          targetX += cover.x;
          targetY += driftY + cover.y;
          targetR += cover.r;

          if (progress >= 1) {
            phase = 'recover';
            phaseStart = time;
            curRecoverDuration = RECOVER_MIN + Math.random() * RECOVER_RANGE;
            window.dispatchEvent(new CustomEvent('flight-turbulence'));
          }
        } else {
          const progress = Math.min(elapsed / curRecoverDuration, 1);
          const resetY = DRIFT_AMP * (1 - smootherstep(progress));
          const cover = coverWobble(ms, (1 - smootherstep(progress)) * RECOVER_SHAKE);

          targetX += cover.x;
          targetY += resetY + cover.y;
          targetR += cover.r;

          if (progress >= 1) {
            phase = 'drift';
            phaseStart = time;
            curDriftDuration = DRIFT_MIN + Math.random() * DRIFT_RANGE;
            window.dispatchEvent(new CustomEvent('flight-turbulence-end'));
          }
        }

        const follow = 0.18;
        currentX += (targetX - currentX) * follow;
        currentY += (targetY - currentY) * follow;
        currentR += (targetR - currentR) * follow;

        chartDom.style.transform =
          `translate3d(${currentX}px, ${currentY}px, 0) rotate(${currentR}deg)`;
      }

      const cleanup = () => {
        cancelAnimationFrame(rafId);
        chartDom.style.transform = '';
        window.removeEventListener('pagehide', cleanup);
        document.removeEventListener('astro:before-swap', cleanup);
      };

      rafId = requestAnimationFrame(tick);
      window.addEventListener('pagehide', cleanup);
      document.addEventListener('astro:before-swap', cleanup);
    }
  }

  initMap();
</script>

<style>
  .map-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    background: #000;
    overflow: hidden;
  }

  .map-chart {
    position: absolute;
    top: -6vh;
    left: -6vw;
    width: 112vw;
    height: 112vh;
    cursor: grab;
    transform-origin: center;
    will-change: transform;
    backface-visibility: hidden;
  }

  .map-chart:active {
    cursor: grabbing;
  }


</style>
