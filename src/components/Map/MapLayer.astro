---
---

<div id="map-container" class="map-container">
  <div id="map-chart" class="map-chart"></div>
</div>

<script>
  import * as echarts from 'echarts';

  const cities = [
    { name: '成都', value: [104.0668, 30.5728] },
    { name: '北京', value: [116.4074, 39.9042] },
    { name: '杭州', value: [120.1551, 30.2741] },
    { name: '广州', value: [113.2644, 23.1291] },
    { name: '厦门', value: [118.0894, 24.4798] },
    { name: '武汉', value: [114.3055, 30.5928] },
    { name: '上海', value: [121.4737, 31.2304] }
  ];

  const tourRoutes = [
    { from: [104.0668, 30.5728], to: [116.4074, 39.9042] },
    { from: [116.4074, 39.9042], to: [120.1551, 30.2741] },
    { from: [120.1551, 30.2741], to: [113.2644, 23.1291] },
    { from: [113.2644, 23.1291], to: [118.0894, 24.4798] },
    { from: [118.0894, 24.4798], to: [114.3055, 30.5928] },
    { from: [114.3055, 30.5928], to: [121.4737, 31.2304] }
  ];

  const PROVINCE_COLORS = [
    '#222222', '#252525', '#282828', '#2b2b2b', '#2e2e2e',
    '#313131', '#232323', '#262626', '#292929', '#2c2c2c',
    '#2f2f2f', '#242424', '#272727', '#2a2a2a', '#2d2d2d',
    '#303030', '#212121', '#323232', '#333333', '#202020',
    '#2e2e2e', '#262626', '#2a2a2a', '#222222', '#2c2c2c',
    '#242424', '#282828', '#303030', '#2f2f2f', '#272727',
    '#2b2b2b', '#232223', '#292929', '#313131'
  ];

  const CENTER: [number, number] = [109, 33];
  const INIT_ZOOM = 5;
  const BOUNDS = { lngMin: 60, lngMax: 145, latMin: 10, latMax: 60 };

  async function initMap() {
    const [neighborsRes, chinaRes] = await Promise.all([
      fetch('/neighbors.geo.json'),
      fetch('https://geo.datav.aliyun.com/areas_v3/bound/100000_full.json')
    ]);
    const neighborsGeo = await neighborsRes.json();
    const chinaGeo = await chinaRes.json();

    // Merge into one GeoJSON: neighbors (without China) + China provinces
    const neighborFeatures = neighborsGeo.features.filter(
      (f: any) => f.properties.name !== 'China'
    );
    const merged = {
      type: 'FeatureCollection' as const,
      features: [...neighborFeatures, ...chinaGeo.features]
    };
    echarts.registerMap('world', merged);

    const regionStyles = merged.features.map((f: any, i: number) => {
      const isNeighbor = i < neighborFeatures.length;
      return {
        name: f.properties.name,
        itemStyle: {
          areaColor: isNeighbor ? '#0e0e0e' : PROVINCE_COLORS[(i - neighborFeatures.length) % PROVINCE_COLORS.length],
          borderColor: isNeighbor
            ? 'rgba(255,255,255,0.04)'
            : 'rgba(255, 105, 180, 0.2)',
          borderWidth: isNeighbor ? 0.5 : 0.8,
          shadowColor: isNeighbor ? 'transparent' : 'rgba(255, 105, 180, 0.15)',
          shadowBlur: isNeighbor ? 0 : 6
        }
      };
    });

    const routeLines = tourRoutes.map(route => ({
      coords: [route.from, route.to]
    }));

    const chartDom = document.getElementById('map-chart')!;
    const mainChart = echarts.init(chartDom, undefined, { renderer: 'svg' });

    mainChart.setOption({
      backgroundColor: 'transparent',
      geo: {
        map: 'world',
        roam: 'move',
        zoom: INIT_ZOOM,
        center: CENTER,
        label: { show: false, color: '#B5E8F7' },
        emphasis: {
          disabled: false,
          label: {
            show: true,
            color: '#B5E8F7',
            fontSize: 12
          },
          itemStyle: {
            areaColor: '#3a3a3a',
            borderColor: 'rgba(255, 105, 180, 0.5)',
            shadowBlur: 12
          }
        },
        select: { disabled: true },
        regions: regionStyles
      },
      series: [
        {
          type: 'lines',
          coordinateSystem: 'geo',
          clip: false,
          z: 1,
          effect: {
            show: true,
            period: 4,
            trailLength: 0.4,
            symbol: 'arrow',
            symbolSize: 6,
            color: '#FF69B4'
          },
          lineStyle: {
            color: 'rgba(255, 105, 180, 0.5)',
            width: 2,
            curveness: 0.2
          },
          data: routeLines
        },
        {
          type: 'effectScatter',
          coordinateSystem: 'geo',
          clip: false,
          z: 2,
          symbol: 'circle',
          symbolSize: 10,
          showEffectOn: 'render',
          rippleEffect: {
            brushType: 'stroke',
            scale: 4,
            period: 3,
            number: 2
          },
          itemStyle: {
            color: '#FF69B4',
            shadowBlur: 20,
            shadowColor: 'rgba(255, 105, 180, 0.8)'
          },
          label: {
            show: true,
            position: 'right',
            formatter: '{b}',
            color: '#ccc',
            fontSize: 12,
            textShadowColor: 'rgba(0,0,0,0.8)',
            textShadowBlur: 4
          },
          data: cities
        }
      ]
    });

    function syncSeriesTransform() {
      const zr = (mainChart as any).getZr();
      const model = (mainChart as any).getModel();
      const geoCoordSys = model.getComponentModel('geo')?.coordinateSystem;
      if (!geoCoordSys?.getRoamTransform) {
        console.warn('[sync] no geoCoordSys or getRoamTransform');
        return;
      }

      const roamMatrix = geoCoordSys.getRoamTransform();
      console.log('[sync] roamMatrix:', roamMatrix);

      const displayList = zr.storage.getDisplayList(true);
      console.log('[sync] displayList length:', displayList.length);

      // 检查前几个元素的结构
      for (let i = 0; i < Math.min(displayList.length, 30); i++) {
        const el = displayList[i];
        const info = (el as any).__ecComponentInfo;
        console.log(`[sync] el[${i}] type=${el.type} ecInfo=`, info, 'hasTransform=', !!el.transform);
      }

      // 尝试通过 echarts 内部 view 找 series group
      const charts = (mainChart as any)._chartsViews || [];
      console.log('[sync] _chartsViews count:', charts.length);
      for (const view of charts) {
        console.log('[sync] view type:', view.type, 'group:', view.group);
      }
    }

    mainChart.on('georoam', () => {
      const opt = mainChart.getOption() as any;
      const geo = opt.geo?.[0];
      if (!geo) return;

      const cz = geo.center as [number, number];
      const z = geo.zoom as number;
      const halfLng = 90 / z;
      const halfLat = 50 / z;

      const clampedLng = Math.max(BOUNDS.lngMin + halfLng, Math.min(BOUNDS.lngMax - halfLng, cz[0]));
      const clampedLat = Math.max(BOUNDS.latMin + halfLat, Math.min(BOUNDS.latMax - halfLat, cz[1]));

      if (clampedLng !== cz[0] || clampedLat !== cz[1]) {
        mainChart.setOption({
          geo: { center: [clampedLng, clampedLat] }
        });
      }

      syncSeriesTransform();
    });

    window.addEventListener('resize', () => mainChart.resize());

    startBreathing();
  }

  function startBreathing() {
    let lastZoomUpdate = 0;
    let lastJitter = 0;

    function tick(time: number) {
      requestAnimationFrame(tick);

      if (time - lastZoomUpdate > 40) {
        lastZoomUpdate = time;
        const t = time / 1000;
        const breathe = INIT_ZOOM + Math.sin(t * 1.1) * 0.06;
        mainChart.setOption({ geo: { zoom: breathe } });
      }

      if (time - lastJitter > 80) {
        lastJitter = time;
        const jx = (Math.random() - 0.5) * 1.8;
        const jy = (Math.random() - 0.5) * 1.2;
        chartDom.style.transform = `translate(${jx}px, ${jy}px)`;
      }
    }

    requestAnimationFrame(tick);
  }

  initMap();
</script>

<style>
  .map-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    background: #000;
  }

  .map-chart {
    width: 100%;
    height: 100%;
    cursor: grab;
  }

  .map-chart:active {
    cursor: grabbing;
  }


</style>
