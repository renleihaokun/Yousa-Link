---
---

<div class="hud-panel glass">
  <div class="network-section">
    <span class="info-label">当前地址：</span>
    <span class="info-value" id="ip-address">检测中...</span>
  </div>

  <div class="divider"></div>

  <div class="player-section">
    <div class="player-row">
      <img class="song-cover" id="song-cover" src="" alt="封面" />
      <div class="song-title" id="song-title">加载中...</div>
      <div class="control-buttons">
        <button class="ctrl-btn" id="prev-btn">⏮</button>
        <button class="ctrl-btn play-btn" id="play-btn">▶</button>
        <button class="ctrl-btn" id="next-btn">⏭</button>
      </div>
    </div>
    <div class="progress-bar" id="progress-bar">
      <div class="progress-fill" id="progress-fill"></div>
    </div>
  </div>
</div>

<script>
  async function fetchNetworkInfo() {
    try {
      const response = await fetch('https://ip.nemui.cn/api/ip');
      const data = await response.json();
      document.getElementById('ip-address')!.textContent = data.ip || '未知';
    } catch {
      document.getElementById('ip-address')!.textContent = '离线';
    }
  }

  fetchNetworkInfo();

  let isPlaying = false;
  let currentAudio: HTMLAudioElement | null = null;
  let songList: Array<{ name: string; url: string; pic: string }> = [];
  let currentIndex = 0;

  async function loadPlaylist() {
    try {
      const response = await fetch('https://meting.mysqil.com/api?server=netease&type=playlist&id=69909382');
      const data = await response.json();
      const raw = Array.isArray(data) ? data : (data.songs || []);
      songList = raw
        .filter((s: any) => s.url && s.url !== '' && s.url !== 'null')
        .map((song: any) => ({
          name: song.name || song.title || '未知',
          url: song.url,
          pic: song.pic || ''
        }));
      updateSongDisplay();
    } catch {
      document.getElementById('song-title')!.textContent = '播放器加载失败';
    }
  }

  function updateSongDisplay() {
    if (songList.length === 0) return;
    const song = songList[currentIndex];
    document.getElementById('song-title')!.textContent = song.name;
    const cover = document.getElementById('song-cover') as HTMLImageElement;
    if (cover && song.pic) {
      cover.classList.remove('loaded');
      cover.src = song.pic;
      cover.onload = () => {
        cover.classList.add('loaded');
      };
    }
  }

  function createAudio() {
    currentAudio?.pause();
    currentAudio = new Audio(songList[currentIndex].url);
    currentAudio.addEventListener('ended', playNext);
    currentAudio.addEventListener('error', playNext);
    currentAudio.addEventListener('timeupdate', updateProgress);
  }

  function safePlay(audio: HTMLAudioElement) {
    audio.play().catch(() => {
      document.getElementById('play-btn')!.textContent = '▶';
      isPlaying = false;
    });
  }

  function updateProgress() {
    if (!currentAudio) return;
    const fill = document.getElementById('progress-fill');
    if (fill && currentAudio.duration) {
      const percent = (currentAudio.currentTime / currentAudio.duration) * 100;
      fill.style.width = `${percent}%`;
    }
  }

  function setPlayingState(playing: boolean) {
    const cover = document.getElementById('song-cover');
    if (playing) {
      cover?.classList.add('playing');
    } else {
      cover?.classList.remove('playing');
    }
  }

  document.getElementById('play-btn')?.addEventListener('click', () => {
    if (songList.length === 0) return;

    if (isPlaying) {
      currentAudio?.pause();
      document.getElementById('play-btn')!.textContent = '▶';
      isPlaying = false;
      setPlayingState(false);
    } else {
      if (!currentAudio) createAudio();
      safePlay(currentAudio!);
      document.getElementById('play-btn')!.textContent = '⏸';
      isPlaying = true;
      setPlayingState(true);
    }
  });

  function playNext() {
    currentIndex = (currentIndex + 1) % songList.length;
    updateSongDisplay();
    const fill = document.getElementById('progress-fill');
    if (fill) fill.style.width = '0%';
    if (currentAudio) {
      createAudio();
      if (isPlaying) safePlay(currentAudio!);
    }
  }

  document.getElementById('next-btn')?.addEventListener('click', playNext);

  document.getElementById('prev-btn')?.addEventListener('click', () => {
    currentIndex = (currentIndex - 1 + songList.length) % songList.length;
    updateSongDisplay();
    const fill = document.getElementById('progress-fill');
    if (fill) fill.style.width = '0%';
    if (currentAudio) {
      createAudio();
      if (isPlaying) safePlay(currentAudio!);
    }
  });

  document.getElementById('progress-bar')?.addEventListener('click', (e) => {
    if (!currentAudio || !currentAudio.duration) return;
    const bar = e.currentTarget as HTMLElement;
    const rect = bar.getBoundingClientRect();
    const ratio = (e.clientX - rect.left) / rect.width;
    currentAudio.currentTime = ratio * currentAudio.duration;
  });

  loadPlaylist();
</script>

<style>
  .hud-panel {
    position: fixed;
    top: 20px;
    right: 20px;
    width: 240px;
    padding: 16px 20px;
    border-radius: 12px;
    z-index: 100;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid var(--color-blue-80);
    box-shadow:
      0 8px 32px rgba(155, 89, 182, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  .network-section {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
  }

  .info-label {
    color: var(--color-text-light);
  }

  .info-value {
    color: #4ADE80;
    font-weight: 500;
  }

  .divider {
    border: none;
    border-top: 1px dashed rgba(155, 89, 182, 0.3);
    margin: 8px 0;
  }

  .player-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .player-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .song-cover {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255, 105, 180, 0.4);
    flex-shrink: 0;
    animation: spin 8s linear infinite;
    animation-play-state: paused;
    background: #2a2a2a;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .song-cover.playing {
    animation-play-state: running;
  }

  .song-cover.loaded {
    opacity: 1;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .song-title {
    flex: 0 1 auto;
    min-width: 0;
    max-width: 120px;
    font-size: 12px;
    font-weight: 400;
    color: var(--color-text-light);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .control-buttons {
    display: flex;
    flex: 1;
    min-width: 55px;
    max-width: 110px;
    justify-content: space-evenly;
    padding: 0;
  }

  .ctrl-btn {
    background: none;
    border: none;
    font-size: 14px;
    cursor: pointer;
    color: var(--color-text);
    transition: color 0.2s;
  }

  .ctrl-btn:hover {
    color: var(--color-pink);
  }

  .play-btn {
    color: var(--color-pink);
  }

  .progress-bar {
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    cursor: pointer;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: #FF69B4;
    width: 0%;
    transition: width 0.1s linear;
  }
</style>
