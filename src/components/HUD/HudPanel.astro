---
import { Disc3, Pause, Play, SkipBack, SkipForward } from 'lucide-astro';
---

<div class="hud-panel glass" aria-label="音乐播放器">
  <div class="player-row">
    <div class="cover-shell" aria-hidden="true">
      <Disc3 class="cover-placeholder" size={22} stroke-width={1.5} />
      <img class="song-cover" id="song-cover" alt="" />
    </div>

    <div class="song-meta">
      <div class="song-title" id="song-title">加载中...</div>
      <div class="song-author" id="song-author">正在连接歌单</div>
    </div>

    <div class="control-buttons">
      <button class="ctrl-btn" id="prev-btn" type="button" aria-label="随机上一首" title="随机上一首" disabled>
        <SkipBack size={17} stroke-width={2} />
      </button>
      <button class="ctrl-btn play-btn" id="play-btn" type="button" aria-label="播放" title="播放" disabled>
        <Play class="play-icon" size={17} stroke-width={2.2} fill="currentColor" />
        <Pause class="pause-icon" size={17} stroke-width={2.2} fill="currentColor" />
      </button>
      <button class="ctrl-btn" id="next-btn" type="button" aria-label="随机下一首" title="随机下一首" disabled>
        <SkipForward size={17} stroke-width={2} />
      </button>
    </div>
  </div>

  <input
    class="progress-bar"
    id="progress-bar"
    type="range"
    min="0"
    max="100"
    step="0.1"
    value="0"
    aria-label="播放进度"
    disabled
  />
</div>

<script>
  import { loadPlaylist, type Song } from '../../services/playlist-service';

  const cover = document.getElementById('song-cover') as HTMLImageElement | null;
  const title = document.getElementById('song-title');
  const author = document.getElementById('song-author');
  const playButton = document.getElementById('play-btn') as HTMLButtonElement | null;
  const previousButton = document.getElementById('prev-btn') as HTMLButtonElement | null;
  const nextButton = document.getElementById('next-btn') as HTMLButtonElement | null;
  const progress = document.getElementById('progress-bar') as HTMLInputElement | null;

  let isPlaying = false;
  let currentAudio: HTMLAudioElement | null = null;
  let songList: Song[] = [];
  let currentIndex = 0;
  const failedUrls = new Set<string>();

  function setControlState(disabled: boolean) {
    if (playButton) playButton.disabled = disabled;
    if (previousButton) previousButton.disabled = disabled;
    if (nextButton) nextButton.disabled = disabled;
  }

  function setProgress(value: number) {
    if (!progress) return;
    const safeValue = Number.isFinite(value) ? Math.max(0, Math.min(100, value)) : 0;
    progress.value = String(safeValue);
    progress.style.setProperty('--progress', `${safeValue}%`);
  }

  function setPlayingState(playing: boolean) {
    isPlaying = playing;
    playButton?.toggleAttribute('data-playing', playing);
    playButton?.setAttribute('aria-label', playing ? '暂停' : '播放');
    playButton?.setAttribute('title', playing ? '暂停' : '播放');
    cover?.classList.toggle('playing', playing);
  }

  function getRandomIndex(excludeIndex?: number, skipFailed = false) {
    if (songList.length <= 1) return 0;
    const candidates = songList
      .map((song, index) => ({ song, index }))
      .filter(({ song, index }) => index !== excludeIndex && (!skipFailed || !failedUrls.has(song.url)));
    if (candidates.length === 0) return excludeIndex ?? 0;
    return candidates[Math.floor(Math.random() * candidates.length)].index;
  }

  function updateSongDisplay() {
    const song = songList[currentIndex];
    if (!song) return;

    if (title) {
      title.textContent = song.name;
      title.title = song.name;
    }
    if (author) {
      author.textContent = song.author || '泠鸢yousa';
      author.title = song.author || '泠鸢yousa';
    }

    cover?.classList.remove('loaded');
    if (cover && song.pic) {
      cover.onload = () => cover.classList.add('loaded');
      cover.onerror = () => cover.classList.remove('loaded');
      cover.src = song.pic;
    } else {
      cover?.removeAttribute('src');
    }

    setProgress(0);
    if (progress) progress.disabled = true;
  }

  function updateProgress() {
    if (!currentAudio?.duration) return;
    setProgress((currentAudio.currentTime / currentAudio.duration) * 100);
  }

  async function safePlay(audio: HTMLAudioElement) {
    try {
      await audio.play();
      setPlayingState(true);
    } catch {
      setPlayingState(false);
    }
  }

  function handleAudioError(url: string, audio: HTMLAudioElement) {
    if (currentAudio !== audio) return;
    failedUrls.add(url);
    if (failedUrls.size >= songList.length) {
      currentAudio?.pause();
      currentAudio = null;
      setPlayingState(false);
      setControlState(true);
      if (progress) progress.disabled = true;
      if (title) title.textContent = '暂无可播放歌曲';
      if (author) author.textContent = '请稍后再试';
      return;
    }
    selectRandomSong(true, true);
  }

  function createAudio() {
    const song = songList[currentIndex];
    if (!song) return null;

    currentAudio?.pause();
    const audio = new Audio(song.url);
    audio.preload = 'metadata';
    audio.addEventListener('ended', () => selectRandomSong(true));
    audio.addEventListener('error', () => handleAudioError(song.url, audio));
    audio.addEventListener('timeupdate', updateProgress);
    audio.addEventListener('loadedmetadata', () => {
      if (progress) progress.disabled = false;
    });
    currentAudio = audio;
    return audio;
  }

  function selectRandomSong(autoplay: boolean, skipFailed = false) {
    if (songList.length === 0) return;
    currentIndex = getRandomIndex(currentIndex, skipFailed);
    setPlayingState(false);
    updateSongDisplay();
    const audio = createAudio();
    if (autoplay && audio) void safePlay(audio);
  }

  async function initializePlaylist() {
    try {
      songList = await loadPlaylist();
      currentIndex = getRandomIndex();
      updateSongDisplay();
      setControlState(false);
    } catch {
      if (title) title.textContent = '播放器加载失败';
      if (author) author.textContent = '请稍后再试';
      setControlState(true);
      if (progress) progress.disabled = true;
    }
  }

  playButton?.addEventListener('click', () => {
    if (songList.length === 0) return;
    if (isPlaying) {
      currentAudio?.pause();
      setPlayingState(false);
      return;
    }

    const audio = currentAudio || createAudio();
    if (audio) void safePlay(audio);
  });

  previousButton?.addEventListener('click', () => selectRandomSong(isPlaying));
  nextButton?.addEventListener('click', () => selectRandomSong(isPlaying));

  progress?.addEventListener('input', () => {
    if (!currentAudio?.duration) return;
    currentAudio.currentTime = (Number(progress.value) / 100) * currentAudio.duration;
    setProgress(Number(progress.value));
  });

  window.addEventListener('pagehide', () => currentAudio?.pause(), { once: true });
  void initializePlaylist();
</script>

<style>
  .hud-panel {
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 100;
    width: 330px;
    padding: 14px 16px 11px;
    border: 1px solid rgba(164, 211, 235, 0.72);
    border-radius: 14px;
    background: rgba(17, 19, 23, 0.82);
    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px) saturate(145%);
    -webkit-backdrop-filter: blur(20px) saturate(145%);
  }

  .player-row {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    align-items: center;
    gap: 11px;
    min-height: 48px;
  }

  .cover-shell {
    position: relative;
    display: grid;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(234, 149, 179, 0.48);
    border-radius: 50%;
    color: rgba(234, 149, 179, 0.72);
    background: rgba(255, 255, 255, 0.05);
  }

  .cover-placeholder,
  .song-cover {
    position: absolute;
    inset: 0;
    margin: auto;
  }

  .song-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 240ms ease;
    animation: spin 9s linear infinite paused;
  }

  .song-cover.loaded {
    opacity: 1;
  }

  .song-cover.playing {
    animation-play-state: running;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .song-meta {
    min-width: 0;
  }

  .song-title,
  .song-author {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .song-title {
    color: var(--color-text);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.45;
  }

  .song-author {
    margin-top: 2px;
    color: var(--color-text-light);
    font-size: 11px;
    line-height: 1.4;
  }

  .control-buttons {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .ctrl-btn {
    display: grid;
    width: 32px;
    height: 36px;
    padding: 0;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: rgba(224, 224, 224, 0.78);
    background: transparent;
    cursor: pointer;
    transition:
      color var(--duration-fast) ease,
      background var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }

  .ctrl-btn:hover:not(:disabled) {
    color: var(--color-white);
    background: rgba(255, 255, 255, 0.08);
  }

  .ctrl-btn:active:not(:disabled) {
    transform: scale(0.92);
  }

  .ctrl-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .play-btn {
    width: 36px;
    color: #17191d;
    background: var(--color-pink);
  }

  .play-btn:hover:not(:disabled) {
    color: #111318;
    background: var(--color-pink-light);
  }

  .pause-icon,
  .play-btn[data-playing] .play-icon {
    display: none;
  }

  .play-btn[data-playing] .pause-icon {
    display: block;
  }

  .progress-bar {
    --progress: 0%;
    display: block;
    width: 100%;
    height: 16px;
    margin: 7px 0 0;
    padding: 0;
    appearance: none;
    border: 0;
    outline: none;
    background: transparent;
    cursor: pointer;
  }

  .progress-bar::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(
      to right,
      var(--color-pink) 0 var(--progress),
      rgba(255, 255, 255, 0.14) var(--progress) 100%
    );
  }

  .progress-bar::-webkit-slider-thumb {
    width: 12px;
    height: 12px;
    margin-top: -4px;
    appearance: none;
    border: 2px solid #17191d;
    border-radius: 50%;
    background: var(--color-pink-light);
    opacity: 0;
    transition: opacity var(--duration-fast) ease;
  }

  .progress-bar:hover::-webkit-slider-thumb,
  .progress-bar:focus-visible::-webkit-slider-thumb {
    opacity: 1;
  }

  .progress-bar::-moz-range-track {
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.14);
  }

  .progress-bar::-moz-range-progress {
    height: 4px;
    border-radius: 2px;
    background: var(--color-pink);
  }

  .progress-bar::-moz-range-thumb {
    width: 10px;
    height: 10px;
    border: 2px solid #17191d;
    border-radius: 50%;
    background: var(--color-pink-light);
  }

  .progress-bar:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .progress-bar:focus-visible {
    outline: 2px solid var(--color-pink);
    outline-offset: 2px;
    border-radius: 4px;
  }

  @media (max-width: 700px) {
    .hud-panel {
      top: var(--safe-top);
      right: var(--safe-right);
      left: calc(var(--safe-left) + var(--location-hud-width) + var(--top-hud-gap));
      width: auto;
      min-height: 66px;
      padding: 9px 8px 6px;
      border-radius: 10px;
    }

    .player-row {
      grid-template-columns: 34px minmax(0, 1fr) auto;
      gap: 6px;
      min-height: 34px;
    }

    .cover-shell {
      width: 34px;
      height: 34px;
    }

    .cover-placeholder {
      width: 17px;
      height: 17px;
    }

    .song-title {
      font-size: 11.5px;
    }

    .song-author {
      margin-top: 0;
      font-size: 9.5px;
    }

    .control-buttons {
      gap: 0;
    }

    .ctrl-btn {
      width: 27px;
      height: 32px;
    }

    .ctrl-btn :global(svg) {
      width: 15px;
      height: 15px;
    }

    .play-btn {
      width: 30px;
    }

    .progress-bar {
      height: 12px;
      margin-top: 3px;
    }
  }

  @media (max-width: 350px) {
    .player-row {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .cover-shell,
    .song-author {
      display: none;
    }
  }
</style>
