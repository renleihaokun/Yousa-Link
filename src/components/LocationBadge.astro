---
---

<div class="location-badge">
  <span class="label">当前位于</span>
  <span class="city" id="current-city">检测中...</span>
</div>

<script>
  import { getNetworkInfo } from '../scripts/network-info';

  async function detectCity() {
    try {
      const data = await getNetworkInfo();
      const city = data.location?.city || '未知';
      document.getElementById('current-city')!.textContent = city;
    } catch {
      document.getElementById('current-city')!.textContent = '未知';
    }
  }

  detectCity();
</script>

<style>
  .location-badge {
    position: fixed;
    top: 24px;
    left: 24px;
    padding: 18px 24px;
    border-radius: 16px;
    z-index: 100;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid var(--color-blue-80);
    box-shadow:
      0 8px 32px rgba(155, 89, 182, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  .label {
    font-size: 13px;
    color: var(--color-text-light);
    letter-spacing: 2px;
  }

  .city {
    font-size: 20px;
    font-weight: 600;
    color: var(--color-text);
  }

  @media (max-width: 700px) {
    .location-badge {
      top: var(--safe-top);
      left: var(--safe-left);
      padding: 12px 14px;
      border-radius: 12px;
    }

    .label {
      font-size: 11px;
      letter-spacing: 1px;
    }

    .city {
      font-size: 16px;
    }
  }
</style>
