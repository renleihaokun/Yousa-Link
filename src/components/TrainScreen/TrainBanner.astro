---
import toursData from '../../data/tours.json';

const { tours } = toursData;
const nextTour = tours[0];
---

<div class="train-screen" id="train-screen">
  <div class="banner card" id="train-banner">
    <div class="banner-content">
      <div class="route-info">
        <span class="from">{nextTour.from}</span>
        <span class="arrow">→</span>
        <span class="to">{nextTour.to}</span>
      </div>
      <div class="date">{nextTour.dateDisplay}</div>
    </div>
    <div class="expand-hint">点击展开</div>
  </div>

  <div class="schedule-panel card" id="schedule-panel">
    <div class="panel-header">
      <h2>2026 全年巡演时刻表</h2>
      <button class="close-btn" id="close-schedule">✕</button>
    </div>
    <div class="schedule-list">
      {tours.map((tour) => (
        <div class="schedule-item">
          <div class="item-date">{tour.dateDisplay}</div>
          <div class="item-route">
            <span class="item-from">{tour.from}</span>
            <span class="item-arrow">→</span>
            <span class="item-to">{tour.to}</span>
          </div>
          <div class="item-status">{tour.venue}</div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  const banner = document.getElementById('train-banner');
  const panel = document.getElementById('schedule-panel');
  const closeBtn = document.getElementById('close-schedule');

  banner?.addEventListener('click', () => {
    banner.classList.add('hidden');
    panel?.classList.add('expanded');
    document.body.classList.add('panel-open');
  });

  closeBtn?.addEventListener('click', () => {
    panel?.classList.remove('expanded');
    banner?.classList.remove('hidden');
    document.body.classList.remove('panel-open');
  });
</script>

<style>
  .train-screen {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 200;
  }

  .banner {
    padding: 16px 32px;
    cursor: pointer;
    transition: all 0.3s ease;
    min-width: 320px;
  }

  .banner:hover {
    transform: scale(1.02);
    box-shadow: var(--shadow-glow);
  }

  .banner.hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-20px);
  }

  .banner-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .route-info {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 18px;
    font-weight: 600;
  }

  .arrow {
    color: var(--color-pink);
  }

  .date {
    font-family: var(--font-pixel);
    font-size: 12px;
    color: var(--color-purple);
  }

  .expand-hint {
    font-size: 11px;
    color: var(--color-text-light);
    text-align: center;
    margin-top: 8px;
  }

  .schedule-panel {
    position: fixed;
    top: 80px;
    left: 50%;
    transform: translateX(-50%) translateY(-20px);
    width: 500px;
    max-height: 70vh;
    overflow-y: auto;
    padding: 24px;
    opacity: 0;
    pointer-events: none;
    transition: all 0.4s ease;
  }

  .schedule-panel.expanded {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .panel-header h2 {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-text);
  }

  .close-btn {
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: var(--color-text-light);
    transition: color 0.2s;
  }

  .close-btn:hover {
    color: var(--color-pink);
  }

  .schedule-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .schedule-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    background: rgba(155, 89, 182, 0.05);
    border-radius: var(--radius-md);
    border: 1px solid rgba(155, 89, 182, 0.1);
    transition: all 0.2s;
  }

  .schedule-item:hover {
    background: rgba(255, 105, 180, 0.1);
    border-color: var(--color-pink);
  }

  .item-date {
    font-family: var(--font-pixel);
    font-size: 11px;
    color: var(--color-purple);
    min-width: 80px;
  }

  .item-route {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
  }

  .item-arrow {
    color: var(--color-pink);
  }

  .item-status {
    font-size: 12px;
    color: var(--color-text-light);
  }
</style>
