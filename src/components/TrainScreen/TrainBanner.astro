---
import toursData from '../../data/tours.json';

const { tours } = toursData;

const sorted = [...tours]
  .map(t => ({ ...t, dateObj: new Date(t.date) }))
  .sort((a, b) => a.dateObj - b.dateObj);

const today = new Date();
today.setHours(0, 0, 0, 0);
const upcomingIdx = sorted.findIndex(t => t.dateObj >= today);
const noUpcoming = upcomingIdx === -1;
const startIdx = noUpcoming ? 0 : upcomingIdx;

const hasTours = sorted.length > 0;
const displayItems = !hasTours
  ? [{ id: 'nest', from: '🪹', to: '鸟窝', dateDisplay: '暂无巡演', venue: '', isNest: true }]
  : noUpcoming
    ? [{ id: 'nest', from: '🪹', to: '鸟窝', dateDisplay: '暂无巡演', venue: '', isNest: true }, ...sorted]
    : [...sorted.slice(startIdx), ...sorted.slice(0, startIdx)];

const MAX_VISIBLE = 3;
const OFFSET = 12;
const W_STEP = 0.08;
const B_STEP = 0.3;
const CARD_H = 82;
const GAP = 14;
const HEADER_H = 52;
const FOOTER_H = 48;
const COUNT = displayItems.length;
const PAD = 14;

const stackedH = CARD_H + (Math.min(COUNT, MAX_VISIBLE) - 1) * OFFSET + PAD;
const expandedH = HEADER_H + COUNT * CARD_H + (COUNT - 1) * GAP + FOOTER_H + PAD * 2;
---

<div class="train-screen" id="train-screen">
  <div
    class="card-stack"
    id="card-stack"
    style={`--stacked-h: ${stackedH}px; --expanded-h: ${expandedH}px;`}
  >
    {displayItems.map((item, i) => {
      const si = Math.min(i, MAX_VISIBLE - 1);
      const hidden = i >= MAX_VISIBLE;
      const expandDelay = si * 42;
      const collapseDelay = Math.max(0, MAX_VISIBLE - 1 - si) * 42;

      return (
        <div
          class={`tour-card${hidden ? ' stack-hidden' : ''}${item.isNest ? ' nest-card' : ''}`}
          style={`
            --stack-top: ${si * OFFSET}px;
            --stack-left: ${si * 4}%;
            --stack-width: calc(100% - ${si * (W_STEP * 100)}%);
            --stack-bright: ${Math.max(0.2, 1 - si * B_STEP)};
            --stack-z: ${COUNT - i};
            --exp-top: ${HEADER_H + i * (CARD_H + GAP)}px;
            --exp-left: 30px;
            --exp-width: calc(100% - 60px);
            --exp-bright: 1;
            --exp-z: ${COUNT - i};
            --expand-delay: ${expandDelay}ms;
            --collapse-delay: ${collapseDelay}ms;
          `}
        >
          <div class="card-body">
            {item.isNest ? (
              <div class="card-nest">
                <span class="nest-icon">🪹</span>
                <span class="nest-text">鸟窝</span>
              </div>
            ) : (
              <>
                <div class="card-info">
                  <div class="card-route">
                    <span class="card-from">{item.from}</span>
                    <span class="card-arrow">→</span>
                    <span class="card-to">{item.to}</span>
                  </div>
                  <div class="card-meta">
                    <span class="card-date">{item.dateDisplay}</span>
                    {item.venue && (
                      <><span class="meta-sep">·</span><span class="card-venue">{item.venue}</span></>
                    )}
                  </div>
                </div>
                <div class="card-right">
                  <div class="card-train">
                    <span class="train-label">车次</span>
                    <span class="train-value">{item.trainNumber || '鸢148'}</span>
                  </div>
                  <div class="card-waiting">
                    <span class="waiting-label">候车室</span>
                    <span class="waiting-value">{item.waitingRoom || '待定'}</span>
                  </div>
                  <div class="card-status">
                    <span class="status-label">预计</span>
                    <span class="status-value">正点</span>
                  </div>
                </div>
              </>
            )}
          </div>
        </div>
      );
    })}

    <div class="stack-footer" id="stack-footer">
      <div class="footer-row">
        <a href="https://github.com/renleihaokun/Yousa-Link" target="_blank" rel="noopener">GitHub</a>
        <span>·</span>
        <span class="footer-version">v0.1</span>
        <span>·</span>
        <a href="https://blog.haokun.me" target="_blank" rel="noopener">blog.haokun.me</a>
      </div>
      <div class="footer-row footer-beian">
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">
          <img src="/assets/beian/foot-icp.png" class="beian-icon" alt="ICP" />
          <span>苏ICP备2026010399号-1</span>
        </a>
        <a href="https://beian.mps.gov.cn/#/query/webSearch?code=32059002007654" target="_blank" rel="noopener">
          <img src="/assets/beian/foot-ga.png" class="beian-icon" alt="公安备案" />
          <span>苏公网安备32059002007654号</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const stack = document.getElementById('card-stack');
  const footer = document.getElementById('stack-footer');

  if (!stack) throw new Error('card-stack not found');

  let reboundTimer: number | undefined;

  let stateTimer: number | undefined;

  function playRebound(type: 'expand' | 'collapse') {
    window.clearTimeout(reboundTimer);
    window.clearTimeout(stateTimer);
    stack.classList.remove('rebounding');
    stack.classList.toggle('is-expanding', type === 'expand');
    stack.classList.toggle('is-collapsing', type === 'collapse');
    requestAnimationFrame(() => {
      stack.classList.add('rebounding');
      reboundTimer = window.setTimeout(() => {
        stack.classList.remove('rebounding');
      }, 720);
      stateTimer = window.setTimeout(() => {
        stack.classList.remove('is-expanding', 'is-collapsing');
      }, 760);
    });
  }

  function expand() {
    if (stack.classList.contains('expanded')) return;
    stack.classList.add('expanded');
    playRebound('expand');
    footer?.classList.add('visible');
    document.body.classList.add('panel-open');
  }

  function collapse() {
    if (!stack.classList.contains('expanded')) return;
    stack.classList.remove('expanded');
    playRebound('collapse');
    footer?.classList.remove('visible');
    document.body.classList.remove('panel-open');
  }

  const obs = new MutationObserver(() => {
    if (!stack.classList.contains('expanded')) {
      footer?.classList.remove('visible');
    }
  });
  obs.observe(stack, { attributes: true, attributeFilter: ['class'] });

  stack.addEventListener('click', () => {
    if (!stack.classList.contains('expanded')) {
      expand();
    }
  });

  stack.querySelectorAll('.tour-card').forEach(card => {
    card.addEventListener('click', (e) => {
      if (stack.classList.contains('expanded')) {
        e.stopPropagation();
        collapse();
      }
    });
  });

  document.addEventListener('click', (e) => {
    if (!stack.classList.contains('expanded')) return;
    
    const target = e.target as HTMLElement;
    if (!target.closest('.card-stack')) {
      collapse();
    }
  });

  window.__collapseTrainScreen = collapse;
</script>

<style>
  .train-screen {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 200;
  }

  .card-stack {
    position: relative;
    width: min(560px, calc(100vw - 40px));
    height: var(--stacked-h);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    --spring: cubic-bezier(0.24, 1.08, 0.34, 1);
    --spring-soft: cubic-bezier(0.22, 1.03, 0.34, 1);
    transition:
      height 0.54s var(--spring),
      background 0.35s ease,
      border 0.35s ease;
    cursor: pointer;
    transform-origin: top center;
    will-change: height, transform;
  }

  .card-stack.expanded {
    height: var(--expanded-h);
    background: rgba(10, 10, 15, 0.5);
    border: 1px solid rgba(255, 105, 180, 0.12);
    overflow-y: auto;
    overscroll-behavior: contain;
    cursor: pointer;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .card-stack.expanded::-webkit-scrollbar {
    display: none;
  }

  .tour-card {
    position: absolute;
    min-height: 82px;
    padding: 16px 22px;
    background: rgba(20, 22, 30, 0.75);
    border: 1px solid rgba(255, 105, 180, 0.35);
    border-radius: var(--radius-md);
    backdrop-filter: blur(24px);
    box-shadow: var(--shadow-card);
    transition:
      top 0.54s var(--spring),
      left 0.54s var(--spring),
      width 0.54s var(--spring),
      filter 0.5s var(--spring-soft),
      opacity 0.4s ease;
    transition-delay: 0ms;
    transform-origin: center;
    will-change: top, left, width, transform;
  }

  .card-stack:not(.expanded) .tour-card {
    top: var(--stack-top);
    left: var(--stack-left);
    width: var(--stack-width);
    filter: brightness(var(--stack-bright));
    z-index: var(--stack-z);
  }

  .card-stack:not(.expanded) .tour-card:nth-child(4) {
    filter: brightness(var(--stack-bright)) blur(0.5px);
    border: 1px solid rgba(255, 105, 180, 0.35);
  }

  .card-stack:not(.expanded) .tour-card.stack-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .card-stack.expanded .tour-card {
    top: var(--exp-top);
    left: var(--exp-left);
    width: var(--exp-width);
    filter: brightness(var(--exp-bright));
    z-index: var(--exp-z);
    opacity: 1;
    pointer-events: auto;
    cursor: pointer;
  }

  .card-stack.is-expanding .tour-card {
    transition-delay: var(--expand-delay, 0ms);
  }

  .card-stack.is-collapsing .tour-card {
    transition-delay: var(--collapse-delay, 0ms);
  }

  .card-stack.expanded .tour-card:hover {
    border-color: var(--color-pink);
    background: rgba(255, 105, 180, 0.18);
  }

  .card-stack.rebounding {
    animation: stack-rebound 0.62s var(--spring-soft) both;
  }

  .card-stack.is-collapsing.rebounding {
    animation: stack-settle 0.54s var(--spring-soft) both;
  }

  .card-stack.is-expanding.rebounding .tour-card {
    animation: card-rebound 0.58s var(--spring-soft) both;
    animation-delay: var(--expand-delay, 0ms);
  }

  @keyframes stack-rebound {
    0% { transform: scaleY(0.992); }
    42% { transform: scaleY(1.012); }
    70% { transform: scaleY(0.997); }
    100% { transform: scaleY(1); }
  }

  @keyframes stack-settle {
    0% { transform: translateY(-2px) scaleY(1.004); }
    55% { transform: translateY(1px) scaleY(0.998); }
    100% { transform: translateY(0) scaleY(1); }
  }

  @keyframes card-rebound {
    0% { transform: translateY(4px) scale(0.992); }
    45% { transform: translateY(-3px) scale(1.006); }
    72% { transform: translateY(1px) scale(0.998); }
    100% { transform: translateY(0) scale(1); }
  }

  .card-body {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    min-height: 48px;
  }

  .card-info {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
  }

  .card-right {
    display: flex;
    gap: 22px;
    align-items: center;
    flex-shrink: 0;
  }

  .status-label {
    color: var(--color-text-light);
  }

  .status-value {
    color: #4ade80;
    font-weight: 600;
  }

  .card-train,
  .card-waiting,
  .card-status {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-size: 12px;
  }

  .card-train {
    min-width: 58px;
  }

  .card-waiting {
    min-width: 92px;
  }

  .card-status {
    min-width: 58px;
  }

  .train-label,
  .waiting-label {
    color: var(--color-text-light);
  }

  .train-value {
    color: var(--color-pink);
    font-weight: 600;
  }

  .waiting-value {
    color: #6b7280;
    font-weight: 600;
  }

  .card-route {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
  }

  .card-from {
    color: var(--color-text-light);
  }

  .card-arrow {
    color: var(--color-pink);
  }

  .card-to {
    color: var(--color-text);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--color-text-light);
  }

  .card-date {
    font-family: var(--font-pixel);
    color: var(--color-purple);
  }

  .meta-sep {
    color: var(--color-text-light);
  }

  .card-venue {
    color: var(--color-text-light);
  }

  .card-nest {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nest-icon {
    font-size: 22px;
  }

  .nest-text {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-text);
  }

  .stack-footer {
    position: absolute;
    left: 30px;
    width: calc(100% - 60px);
    bottom: 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    padding: 0 16px;
    font-size: 11px;
    color: var(--color-text-light);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease 0.3s;
  }

  .footer-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
  }

  .footer-beian a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .beian-icon {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }

  .stack-footer.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .stack-footer a {
    color: var(--color-purple);
    text-decoration: none;
    transition: color 0.2s;
  }

  .stack-footer a:hover {
    color: var(--color-pink);
  }

  @media (max-width: 1228px) {
    .train-screen {
      top: 128px;
    }
  }

  @media (max-width: 700px) {
    .train-screen {
      top: 112px;
    }

    .tour-card {
      padding: 14px 16px;
    }

    .card-body {
      gap: 10px;
    }

    .card-right {
      gap: 12px;
    }

    .card-route {
      font-size: 15px;
    }

    .card-meta,
    .card-train,
    .card-waiting,
    .card-status {
      font-size: 11px;
    }

    .card-waiting {
      min-width: 68px;
    }
  }

  @media (max-width: 520px) {
    .card-right {
      display: none;
    }

    .card-route,
    .card-meta {
      white-space: normal;
    }
  }
</style>
