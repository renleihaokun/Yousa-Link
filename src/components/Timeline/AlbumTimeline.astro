---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import albumsData from '../../data/albums.json';

const { albums } = albumsData;
type AlbumAsset = { src: string; sources: Array<{ src: string; width: number }> };
const manifestPath = join(process.cwd(), 'public', 'generated', 'albums', 'manifest.json');
const albumManifest = JSON.parse(readFileSync(manifestPath, 'utf8')) as { version: 1; items: AlbumAsset[] };
const albumAssets = new Map(albumManifest.items.map((item) => [item.src, item.sources]));
---

<div class="timeline-end-guard" id="timeline-end-guard" aria-hidden="true"></div>

<div class="timeline-section" id="timeline-section">
  <div class="timeline-handle">
    <div class="handle-bar"></div>
  </div>
  <div class="timeline-header">
    <h2>专辑时间线</h2>
  </div>
  
  <div class="timeline-content">
    {albums.map((album, index) => (
      <div class={`timeline-item ${index % 2 === 0 ? 'left' : 'right'}`}>
        <div class="timeline-dot"></div>
        <div class="timeline-card card">
          <div class="album-year">{album.year}</div>
          <div class="album-cover">
            <picture>
              <source
                type="image/webp"
                srcset={albumAssets.get(album.cover)?.map((source) => `${source.src} ${source.width}w`).join(', ')}
                sizes="(max-width: 760px) calc(100vw - 100px), 420px"
              />
              <img src={album.cover} alt={album.title} loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="album-info">
            <h3 class="album-title">{album.title}</h3>
            <p class="album-desc">{album.description}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  import { clearSceneBlur, setSceneBlur } from '../../scripts/scene-blur-controller';
  import { shouldPeekTimeline } from '../../domain/timeline-hint';

  const PEEK_CLASS = 'timeline-peek';
  const PEEK_MAX_WAIT_MS = 8_000;
  const timelineSection = document.getElementById('timeline-section');
  let blurFrame = 0;
  let peekActive = false;

  function updateTimelineDepth() {
    blurFrame = 0;
    // 弹跳期间拿到的是动画中的位置，按它算会在页面顶部误判成"已经滑到时间线"
    if (peekActive) return;
    if (!timelineSection) return;

    const viewport = window.visualViewport;
    const viewportHeight = Math.max(viewport?.height ?? window.innerHeight, 1);
    const viewportTop = viewport?.pageTop ?? window.scrollY;
    const sectionTop = timelineSection.getBoundingClientRect().top;
    const progress = Math.min(1, Math.max(0, (viewportHeight - sectionTop) / viewportHeight));
    const isActive = progress > 0.001;
    const remainingScroll = document.documentElement.scrollHeight - (viewportTop + viewportHeight);
    const isAtEnd = isActive && remainingScroll <= 2;

    setSceneBlur('timeline', progress * 18);
    document.documentElement.classList.toggle('timeline-active', isActive);
    document.documentElement.classList.toggle('timeline-at-end', isAtEnd);
  }

  function queueTimelineDepthUpdate() {
    if (blurFrame) return;
    blurFrame = requestAnimationFrame(updateTimelineDepth);
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });

  document.querySelectorAll('.timeline-item').forEach(item => {
    observer.observe(item);
  });

  window.addEventListener('scroll', queueTimelineDepthUpdate, { passive: true });
  window.addEventListener('resize', queueTimelineDepthUpdate);
  window.visualViewport?.addEventListener('scroll', queueTimelineDepthUpdate, { passive: true });
  window.visualViewport?.addEventListener('resize', queueTimelineDepthUpdate);
  queueTimelineDepthUpdate();

  function timelinePeekAllowed() {
    return shouldPeekTimeline({
      reducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      scrollY: window.scrollY,
      timelineActive: document.documentElement.classList.contains('timeline-active'),
      panelOpen: Boolean(document.body.dataset.openPanel)
    });
  }

  function teardownTimelinePeek() {
    peekActive = false;
    timelineSection?.classList.remove(PEEK_CLASS);
    timelineSection?.removeEventListener('animationend', handleTimelinePeekEnd);
    window.removeEventListener('scroll', stopTimelinePeek);
    window.removeEventListener('wheel', stopTimelinePeek);
    window.removeEventListener('touchstart', stopTimelinePeek);
  }

  function stopTimelinePeek() {
    if (!peekActive) return;
    teardownTimelinePeek();
    queueTimelineDepthUpdate();
  }

  function handleTimelinePeekEnd(event: AnimationEvent) {
    if (event.target === timelineSection) stopTimelinePeek();
  }

  function startTimelinePeek() {
    if (peekActive || !timelineSection || !timelinePeekAllowed()) return;
    peekActive = true;
    timelineSection.classList.add(PEEK_CLASS);
    timelineSection.addEventListener('animationend', handleTimelinePeekEnd);
    // 用户一动页面就收手，免得弹跳和滚动打架
    window.addEventListener('scroll', stopTimelinePeek, { passive: true });
    window.addEventListener('wheel', stopTimelinePeek, { passive: true });
    window.addEventListener('touchstart', stopTimelinePeek, { passive: true });
  }

  // 首访提示浮层会挡住整个页面，等它关掉再弹
  function whenEntryNoticeClosed(callback: () => void) {
    const noticeOpen = () => Boolean(document.getElementById('entry-notice-overlay'));
    if (!noticeOpen()) {
      callback();
      return;
    }

    let settled = false;
    let timeoutId = 0;
    let observer: MutationObserver | undefined;
    const finish = () => {
      if (settled) return;
      settled = true;
      window.clearTimeout(timeoutId);
      observer?.disconnect();
      callback();
    };

    observer = new MutationObserver(() => {
      if (!noticeOpen()) finish();
    });
    timeoutId = window.setTimeout(finish, PEEK_MAX_WAIT_MS);
    observer.observe(document.body, { childList: true, subtree: true });
  }

  function scheduleTimelinePeek() {
    whenEntryNoticeClosed(startTimelinePeek);
  }

  if (document.readyState === 'complete') scheduleTimelinePeek();
  else window.addEventListener('load', scheduleTimelinePeek, { once: true });

  function cleanupTimelineDepth() {
    if (blurFrame) cancelAnimationFrame(blurFrame);
    teardownTimelinePeek();
    observer.disconnect();
    window.removeEventListener('scroll', queueTimelineDepthUpdate);
    window.removeEventListener('resize', queueTimelineDepthUpdate);
    window.visualViewport?.removeEventListener('scroll', queueTimelineDepthUpdate);
    window.visualViewport?.removeEventListener('resize', queueTimelineDepthUpdate);
    clearSceneBlur('timeline');
    document.documentElement.classList.remove('timeline-active');
    document.documentElement.classList.remove('timeline-at-end');
  }

  document.addEventListener('astro:before-swap', cleanupTimelineDepth, { once: true });
</script>

<style>
  :global(html.timeline-active) {
    background: #83a9bc;
    overscroll-behavior-y: none;
  }

  :global(html.timeline-active body) {
    background: #83a9bc;
  }

  .timeline-section,
  .timeline-end-guard {
    --timeline-end-guard-height: max(96px, calc(var(--safe-bottom) + 64px));
  }

  .timeline-end-guard {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    height: var(--timeline-end-guard-height);
    visibility: hidden;
    opacity: 0;
    background: #83a9bc;
    pointer-events: none;
    z-index: 249;
  }

  :global(html.timeline-at-end) .timeline-end-guard {
    visibility: visible;
    opacity: 1;
  }

  .timeline-section {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    padding: 0 48px 180px;
    padding-bottom: max(180px, 30svh);
    margin-top: 100vh;
    margin-top: 100svh;
    background: linear-gradient(
      to bottom,
      var(--color-blue-80) 0,
      var(--color-blue-80) calc(100% - var(--timeline-end-guard-height) - var(--timeline-end-guard-height)),
      #83a9bc calc(100% - var(--timeline-end-guard-height)),
      #83a9bc 100%
    );
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    z-index: 250;
  }

  .timeline-handle {
    display: flex;
    justify-content: center;
    padding: 16px 0 12px;
    cursor: grab;
    user-select: none;
  }

  .handle-bar {
    width: 56px;
    height: 5px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.15);
    transition: background 0.3s ease;
  }

  .timeline-handle:hover .handle-bar {
    background: rgba(255, 255, 255, 0.3);
  }

  /* 加载完成后弹两下露出手柄，提示下方还有内容 */
  .timeline-section.timeline-peek {
    animation: timeline-peek 1.35s var(--ease-standard);
  }

  .timeline-section.timeline-peek .handle-bar {
    background: rgba(255, 255, 255, 0.3);
  }

  @keyframes timeline-peek {
    0% {
      transform: translateY(0);
    }

    18% {
      transform: translateY(-60px);
    }

    38% {
      transform: translateY(-8px);
    }

    58% {
      transform: translateY(-46px);
    }

    78% {
      transform: translateY(-6px);
    }

    100% {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-section.timeline-peek {
      animation: none;
    }
  }

  .timeline-header {
    text-align: center;
    margin-bottom: 72px;
  }

  .timeline-header h2 {
    font-size: 32px;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 24px;
  }

  .timeline-content {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
  }

  .timeline-content::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(155, 89, 182, 0.3);
    transform: translateX(-50%);
  }

  .timeline-item {
    position: relative;
    width: 50%;
    padding: 24px 48px;
    z-index: 1;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity var(--duration-slow) ease, transform var(--duration-slow) var(--ease-standard);
  }

  .timeline-item:first-child {
    margin-top: 0 !important;
  }

  .timeline-item:hover {
    z-index: 2;
  }

  .timeline-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .timeline-item.left {
    left: 0;
    padding-right: 72px;
    text-align: right;
  }

  .timeline-item.right {
    left: 50%;
    padding-left: 72px;
  }

  .timeline-dot {
    position: absolute;
    width: 16px;
    height: 16px;
    background: var(--color-pink);
    border: 3px solid white;
    border-radius: 50%;
    box-shadow: var(--shadow-glow);
    z-index: 1;
  }

  .timeline-item.left .timeline-dot {
    right: -8px;
  }

  .timeline-item.right .timeline-dot {
    left: -8px;
  }

  .timeline-section::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border-top: 2px solid rgba(220, 240, 255, 0.7);
    pointer-events: none;
    z-index: 10;
  }

  .timeline-card {
    padding: 26px;
    transition: transform 0.3s;
  }

  .timeline-card:hover {
    transform: scale(1.02);
  }

  .album-year {
    font-family: var(--font-pixel);
    font-size: 15px;
    color: var(--color-purple);
    margin-bottom: 14px;
  }

  .album-cover {
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 20px;
  }

  .album-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .album-cover picture {
    display: contents;
  }

  .album-title {
    font-size: 21px;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 6px;
  }

  .album-desc {
    font-size: 14px;
    color: var(--color-text-light);
  }

  @media (max-width: 760px) {
    .timeline-section {
      padding: 0 16px calc(180px + var(--safe-bottom));
      padding-bottom: max(calc(180px + var(--safe-bottom)), calc(30svh + var(--safe-bottom)));
      border-radius: 20px 20px 0 0;
    }

    .timeline-content::before {
      left: 20px;
    }

    .timeline-item,
    .timeline-item.left,
    .timeline-item.right {
      left: 0;
      width: 100%;
      padding: 20px 0 20px 52px;
      margin-top: 0 !important;
      text-align: left;
    }

    .timeline-item.left .timeline-dot,
    .timeline-item.right .timeline-dot {
      left: 12px;
      right: auto;
    }
  }
</style>
