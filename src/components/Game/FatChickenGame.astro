---
---

<div class="game-container" id="game-container">
  <button class="game-tab" id="game-tab" type="button" aria-label="打开抓肥鸡游戏">
    <span class="tab-arrow">‹</span>
    <img class="tab-thumb" id="tab-thumb" src="/images/game/yousa-chicken.png" alt="肥鸡" />
    <span class="tab-label">抓肥鸡</span>
  </button>

  <img class="hero-chicken" id="hero-chicken" src="/images/game/yousa-chicken.png" alt="" />

  <div class="game-panel" id="game-panel">
    <div class="game-header">
      <div class="game-title">
        <h2>抓肥鸡</h2>
        <span class="game-status" id="game-status">追捕中</span>
      </div>
      <div class="game-stats" aria-label="游戏统计">
        <div class="game-stat">
          <span>得分</span>
          <b id="game-score">0000</b>
        </div>
        <div class="game-stat">
          <span>连抓</span>
          <b id="game-streak">0</b>
        </div>
        <div class="game-stat">
          <span>最快</span>
          <b id="best-reaction">--</b>
        </div>
        <div class="game-stat catch-counter">
          <span>累计捕获</span>
          <b id="catch-count">0</b>
        </div>
      </div>
    </div>
    <div class="canvas-wrap">
      <canvas id="game-canvas"></canvas>
      <div class="combo-callout" id="combo-callout" aria-live="polite"></div>
    </div>
  </div>

  <button class="close-tab" id="close-tab" type="button" aria-label="关闭游戏">
    <span>›</span>
  </button>
</div>

<script>
  import { closePanel, onPanelClose, openPanel } from '../../scripts/panel-controller';

  const spriteSrc = '/images/game/yousa-chicken.png';
  const CHICKEN_HEIGHT = 64;
  const DEFAULT_CHICKEN_RATIO = 500 / 380;
  const ALPHA_HIT_THRESHOLD = 32;
  const gameContainer = document.getElementById('game-container');
  const tab = document.getElementById('game-tab');
  const tabThumb = document.getElementById('tab-thumb') ;
  const heroChicken = document.getElementById('hero-chicken') ;
  const panel = document.getElementById('game-panel');
  const closeTab = document.getElementById('close-tab');
  const canvas = document.getElementById('game-canvas') ;
  const catchCount = document.getElementById('catch-count');
  const scoreEl = document.getElementById('game-score');
  const streakEl = document.getElementById('game-streak');
  const bestReactionEl = document.getElementById('best-reaction');
  const statusEl = document.getElementById('game-status');
  const comboCallout = document.getElementById('combo-callout');
  type MotionState = 'closed' | 'opening' | 'open' | 'closing';
  let motionState: MotionState = 'closed';
  let isExpanded = false;
  let transitionVersion = 0;
  let entryRect: DOMRect | null = null;
  let activeAnimations: Animation[] = [];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let count = Math.max(0, Number.parseInt(localStorage.getItem('yousa-catch-count') || '0', 10) || 0);
  let score = 0;
  let streak = 0;
  let bestReaction = Math.max(0, Number.parseInt(localStorage.getItem('yousa-catch-best-reaction') || '0', 10) || 0);
  let animId = 0;
  let sprite: HTMLImageElement;
  let spriteReady: Promise<void> | null = null;
  let ctx: CanvasRenderingContext2D;
  let lastFrameTime = 0;
  let targetLiveSince = 0;
  let calloutTimer = 0;
  let spritePixels: Uint8ClampedArray | null = null;
  let spritePixelWidth = 0;
  let spritePixelHeight = 0;

  // Chicken state
  let chicken = {
    x: 0,
    y: 0,
    vx: 5,
    vy: 4,
    width: CHICKEN_HEIGHT * DEFAULT_CHICKEN_RATIO,
    height: CHICKEN_HEIGHT
  };
  let bobbing = 0;

  // Cage animation state
  let cageActive = false;
  let cagePhase = 0;      
  let cageTimer = 0;      
  let lastCageTime = 0;
  let chickenCaughtX = 0;
  let chickenCaughtY = 0;

  type Effect = {
    x: number;
    y: number;
    age: number;
    duration: number;
    kind: 'hit' | 'miss';
  };
  const effects: Effect[] = [];

  // Entry animation
  let entering = false;
  let enterProgress = 0;
  let enterFromX = 0;
  let enterFromY = 0;
  let enterToX = 0;
  let enterToY = 0;
  let enterDuration = 500;
  let enterStartTime = 0;

  const nextFrame = () => new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));

  function cancelElementAnimations(element: Element | null, subtree = false) {
    element?.getAnimations({ subtree }).forEach((animation) => animation.cancel());
  }

  function cancelMotion() {
    activeAnimations.forEach((animation) => animation.cancel());
    activeAnimations = [];
    cancelElementAnimations(heroChicken);
    cancelElementAnimations(panel, true);
  }

  function animateElement(
    element: Element | null,
    keyframes: Keyframe[],
    options: KeyframeAnimationOptions
  ) {
    if (!element || reduceMotion.matches) return Promise.resolve();
    const animation = element.animate(keyframes, options);
    activeAnimations.push(animation);
    return animation.finished.catch(() => undefined);
  }

  function placeHero(rect: DOMRect) {
    Object.assign(heroChicken.style, {
      display: 'block',
      position: 'fixed',
      left: `${rect.left}px`,
      top: `${rect.top}px`,
      width: `${rect.width}px`,
      height: `${rect.height}px`,
      borderRadius: '8px',
      transform: 'none',
      transformOrigin: 'top left',
      opacity: '1',
      zIndex: '302',
      pointerEvents: 'none',
      transition: 'none'
    });
  }

  function heroTransform(from: DOMRect, to: DOMRect) {
    return `translate3d(${from.left - to.left}px, ${from.top - to.top}px, 0) scale(${from.width / to.width}, ${from.height / to.height})`;
  }

  function resizeCanvas() {
    const wrap = canvas.parentElement!;
    const rect = wrap.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    canvas.style.width = rect.width + 'px';
    canvas.style.height = rect.height + 'px';
    if (ctx) {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.imageSmoothingEnabled = false;
      clampChickenToCanvas();
    }
  }

  function getCanvasSize() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    return {
      width: canvas.width / dpr,
      height: canvas.height / dpr
    };
  }

  function clampChickenToCanvas() {
    const { width, height } = getCanvasSize();
    const maxX = Math.max(0, width - chicken.width);
    const maxY = Math.max(0, height - chicken.height);

    if (entering) {
      enterToX = Math.min(maxX, Math.max(0, enterToX));
      enterToY = Math.min(maxY, Math.max(0, enterToY));
      return;
    }

    chicken.x = Math.min(maxX, Math.max(0, chicken.x));
    chicken.y = Math.min(maxY, Math.max(0, chicken.y));
    if (cageActive) {
      chickenCaughtX = Math.min(maxX, Math.max(0, chickenCaughtX));
      chickenCaughtY = Math.min(maxY, Math.max(0, chickenCaughtY));
    }
  }

  function spawnChicken() {
    const { width, height } = getCanvasSize();
    const maxX = Math.max(0, width - chicken.width);
    const maxY = Math.max(0, height - chicken.height);

    chicken.x = Math.random() * maxX;
    chicken.y = Math.random() * maxY;

    const angle = Math.random() * Math.PI * 2;
    const speed = 240 + Math.random() * 180;
    chicken.vx = Math.cos(angle) * speed;
    chicken.vy = Math.sin(angle) * speed;
  }

  function startEntry() {
    const { width, height } = getCanvasSize();
    const maxX = Math.max(0, width - chicken.width);
    const maxY = Math.max(0, height - chicken.height);

    const edge = Math.floor(Math.random() * 4);
    switch (edge) {
      case 0:
        enterFromX = Math.random() * maxX; enterFromY = -chicken.height;
        enterToX = enterFromX; enterToY = Math.min(maxY, Math.random() * maxY * 0.5 + chicken.height);
        break;
      case 1:
        enterFromX = width + chicken.width; enterFromY = Math.random() * maxY;
        enterToX = Math.min(maxX, Math.random() * maxX * 0.5 + chicken.width); enterToY = enterFromY;
        break;
      case 2:
        enterFromX = Math.random() * maxX; enterFromY = height + chicken.height;
        enterToX = enterFromX; enterToY = Math.max(0, maxY - Math.random() * maxY * 0.5);
        break;
      case 3:
        enterFromX = -chicken.width; enterFromY = Math.random() * maxY;
        enterToX = Math.min(maxX, Math.random() * maxX * 0.5 + chicken.width); enterToY = enterFromY;
        break;
    }
    chicken.x = enterFromX;
    chicken.y = enterFromY;
    entering = true;
    enterProgress = 0;
    enterStartTime = performance.now();
  }

  function ensureSprite() {
    if (spriteReady) return spriteReady;
    spriteReady = new Promise<void>((resolve) => {
      sprite = new Image();
      sprite.src = spriteSrc;
      sprite.onload = () => {
        const targetHeight = window.matchMedia('(max-width: 767px)').matches ? 78 : CHICKEN_HEIGHT;
        chicken.width = targetHeight * (sprite.naturalWidth / sprite.naturalHeight);
        chicken.height = targetHeight;
        prepareSpritePixels();
        resolve();
      };
      sprite.onerror = () => resolve();
    });
    return spriteReady;
  }

  async function prepareCanvasForLanding() {
    ctx = canvas.getContext('2d')!;
    resizeCanvas();
    await ensureSprite();
    const { width, height } = getCanvasSize();
    chicken.x = Math.max(0, Math.min(width - chicken.width, width * 0.62 - chicken.width / 2));
    chicken.y = Math.max(0, Math.min(height - chicken.height, height * 0.42 - chicken.height / 2));
    const angle = Math.random() * Math.PI * 2;
    chicken.vx = Math.cos(angle) * 260;
    chicken.vy = Math.sin(angle) * 260;
    entering = false;
    cageActive = false;
    bobbing = 0;
    effects.length = 0;
    targetLiveSince = performance.now();
    ctx.clearRect(0, 0, width, height);

    const canvasRect = canvas.getBoundingClientRect();
    return new DOMRect(
      canvasRect.left + chicken.x,
      canvasRect.top + chicken.y,
      chicken.width,
      chicken.height
    );
  }

  function prepareSpritePixels() {
    const maskCanvas = document.createElement('canvas');
    maskCanvas.width = sprite.naturalWidth;
    maskCanvas.height = sprite.naturalHeight;
    const maskCtx = maskCanvas.getContext('2d', { willReadFrequently: true });
    if (!maskCtx) return;

    try {
      maskCtx.drawImage(sprite, 0, 0);
      spritePixels = maskCtx.getImageData(0, 0, maskCanvas.width, maskCanvas.height).data;
      spritePixelWidth = maskCanvas.width;
      spritePixelHeight = maskCanvas.height;
    } catch {
      spritePixels = null;
      spritePixelWidth = 0;
      spritePixelHeight = 0;
    }
  }

  function updatePhysics(dt: number) {
    const { width, height } = getCanvasSize();

    chicken.x += chicken.vx * dt;
    chicken.y += chicken.vy * dt;

    if (chicken.x < 0) { chicken.x = 0; chicken.vx = Math.abs(chicken.vx); }
    if (chicken.x + chicken.width > width) { chicken.x = width - chicken.width; chicken.vx = -Math.abs(chicken.vx); }
    if (chicken.y < 0) { chicken.y = 0; chicken.vy = Math.abs(chicken.vy); }
    if (chicken.y + chicken.height > height) { chicken.y = height - chicken.height; chicken.vy = -Math.abs(chicken.vy); }

    if (Math.random() < 1 - Math.pow(0.98, dt * 60)) {
      const angle = Math.random() * Math.PI * 2;
      const speed = Math.min(360, Math.sqrt(chicken.vx * chicken.vx + chicken.vy * chicken.vy) + (Math.random() - 0.5) * 120);
      chicken.vx = Math.cos(angle) * Math.max(180, speed);
      chicken.vy = Math.sin(angle) * Math.max(180, speed);
    }

    bobbing += 4.8 * dt;
  }

  function getBobOffset() {
    return Math.sin(bobbing) * 2;
  }

  function updateHud() {
    if (catchCount) catchCount.textContent = count.toString();
    if (scoreEl) scoreEl.textContent = score.toString().padStart(4, '0');
    if (streakEl) streakEl.textContent = streak.toString();
    if (bestReactionEl) bestReactionEl.textContent = bestReaction ? `${(bestReaction / 1000).toFixed(2)}s` : '--';
    if (statusEl) statusEl.textContent = streak >= 3 ? `火热 x${Math.min(4, 1 + Math.floor(streak / 3))}` : '追捕中';
  }

  function showCallout(text: string, kind: 'hit' | 'miss') {
    if (!comboCallout) return;
    comboCallout.textContent = text;
    comboCallout.className = `combo-callout visible ${kind}`;
    window.clearTimeout(calloutTimer);
    calloutTimer = window.setTimeout(() => comboCallout.classList.remove('visible'), 650);
  }

  function addEffect(x: number, y: number, kind: 'hit' | 'miss') {
    effects.push({ x, y, age: 0, duration: kind === 'hit' ? 520 : 360, kind });
  }

  function updateEffects(dtMs: number) {
    for (let i = effects.length - 1; i >= 0; i--) {
      effects[i].age += dtMs;
      if (effects[i].age >= effects[i].duration) effects.splice(i, 1);
    }
  }

  function drawEffects() {
    effects.forEach((effect) => {
      const progress = effect.age / effect.duration;
      const alpha = 1 - progress;
      ctx.save();
      ctx.globalAlpha = alpha;
      ctx.strokeStyle = effect.kind === 'hit' ? '#ea95b3' : '#ffffff';
      ctx.lineWidth = effect.kind === 'hit' ? 4 : 2;
      ctx.beginPath();
      ctx.arc(effect.x, effect.y, 12 + progress * (effect.kind === 'hit' ? 64 : 28), 0, Math.PI * 2);
      ctx.stroke();

      if (effect.kind === 'hit') {
        ctx.fillStyle = '#fcd550';
        for (let i = 0; i < 8; i++) {
          const angle = (Math.PI * 2 * i) / 8;
          const distance = 18 + progress * 72;
          ctx.beginPath();
          ctx.arc(effect.x + Math.cos(angle) * distance, effect.y + Math.sin(angle) * distance, 4 * alpha, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.restore();
    });
  }

  function drawChicken(px: number, py: number) {
    const { width, height } = chicken;
    if (sprite && sprite.complete && sprite.naturalWidth > 0) {
      ctx.save();
      ctx.translate(px + width / 2, py + height / 2 + getBobOffset());
      ctx.drawImage(sprite, -width / 2, -height / 2, width, height);
      ctx.restore();
    } else {
      ctx.save();
      ctx.translate(px + width / 2, py + height / 2);
      ctx.fillStyle = '#ea95b3';
      ctx.fillRect(-width / 2, -height / 2, width, height);
      ctx.fillStyle = '#fff';
      ctx.font = `${height * 0.6}px sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('🐔', 0, 0);
      ctx.restore();
    }
  }

  function isChickenHit(mx: number, my: number) {
    const localX = mx - chicken.x;
    const localY = my - chicken.y - getBobOffset();
    if (localX < 0 || localX >= chicken.width || localY < 0 || localY >= chicken.height) {
      return false;
    }

    if (!spritePixels || !spritePixelWidth || !spritePixelHeight) {
      return true;
    }

    const pixelX = Math.min(spritePixelWidth - 1, Math.floor(localX / chicken.width * spritePixelWidth));
    const pixelY = Math.min(spritePixelHeight - 1, Math.floor(localY / chicken.height * spritePixelHeight));
    const alpha = spritePixels[(pixelY * spritePixelWidth + pixelX) * 4 + 3];
    return alpha > ALPHA_HIT_THRESHOLD;
  }

  function drawCage(cx: number, cy: number, progress: number) {
    const cw = chicken.width + 24;
    const ch = chicken.height + 24;
    const startY = cy - ch / 2 - 120;
    const endY = cy - ch / 2;

    let drawY: number;
    let alpha = 1;
    if (progress < 1) {
      drawY = startY + (endY - startY) * progress;
    } else if (progress < 1.4) {
      drawY = endY;
    } else {
      const lift = (progress - 1.4) / 0.6;
      drawY = endY - lift * 150;
      alpha = 1 - lift;
    }

    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.strokeStyle = '#5a3a1a';
    ctx.lineWidth = 4;
    ctx.strokeRect(cx - cw / 2, drawY, cw, ch);

    ctx.strokeStyle = '#7a5a3a';
    ctx.lineWidth = 2;
    for (let i = 1; i < 4; i++) {
      const bx = cx - cw / 2 + (cw / 4) * i;
      ctx.beginPath();
      ctx.moveTo(bx, drawY);
      ctx.lineTo(bx, drawY + ch);
      ctx.stroke();
    }
    for (let i = 1; i < 3; i++) {
      const by = drawY + (ch / 3) * i;
      ctx.beginPath();
      ctx.moveTo(cx - cw / 2, by);
      ctx.lineTo(cx + cw / 2, by);
      ctx.stroke();
    }

    ctx.strokeStyle = '#5a3a1a';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.arc(cx, drawY - 14, 8, Math.PI, 0);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(cx - 8, drawY - 14);
    ctx.lineTo(cx, drawY);
    ctx.moveTo(cx + 8, drawY - 14);
    ctx.lineTo(cx, drawY);
    ctx.stroke();

    ctx.restore();
  }

  function startCage() {
    cageActive = true;
    cagePhase = 0;
    cageTimer = 0;
    lastCageTime = performance.now();
    chickenCaughtX = chicken.x;
    chickenCaughtY = chicken.y;
    const reaction = Math.max(0, Math.round(performance.now() - targetLiveSince));
    streak++;
    const multiplier = Math.min(4, 1 + Math.floor(streak / 3));
    const gained = Math.max(100, 1000 - reaction) * multiplier;
    score += gained;
    if (!bestReaction || reaction < bestReaction) {
      bestReaction = reaction;
      localStorage.setItem('yousa-catch-best-reaction', bestReaction.toString());
    }
    addEffect(chicken.x + chicken.width / 2, chicken.y + chicken.height / 2 + getBobOffset(), 'hit');
    showCallout(`+${gained}${multiplier > 1 ? `  x${multiplier}` : ''}`, 'hit');
    updateHud();
  }

  function updateCage() {
    const now = performance.now();
    const dt = now - lastCageTime;
    lastCageTime = now;
    cageTimer += dt;

    if (cagePhase === 0) {
      if (cageTimer >= 300) { cagePhase = 1; cageTimer = 0; }
    } else if (cagePhase === 1) {
      if (cageTimer >= 220) { cagePhase = 2; cageTimer = 0; }
    } else if (cagePhase === 2) {
      if (cageTimer >= 300) {
        cageActive = false;
        count++;
        localStorage.setItem('yousa-catch-count', count.toString());
        updateHud();
        fetch('/api/catch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ count })
        }).catch(() => {});
        startEntry();
      }
    }
  }

  function getCageProgress(): number {
    if (cagePhase === 0) return cageTimer / 300;
    if (cagePhase === 1) return 1 + 0.4 * (cageTimer / 220);
    return 1.4 + 0.6 * (cageTimer / 300);
  }

  function updateEntry() {
    const now = performance.now();
    enterProgress = Math.min(1, (now - enterStartTime) / enterDuration);

    const t = easeOutCubic(enterProgress);
    chicken.x = enterFromX + (enterToX - enterFromX) * t;
    chicken.y = enterFromY + (enterToY - enterFromY) * t;

    if (enterProgress >= 1) {
      entering = false;
      chicken.x = enterToX;
      chicken.y = enterToY;
      targetLiveSince = performance.now();
    }
  }

  function easeOutCubic(t: number): number {
    return 1 - Math.pow(1 - t, 3);
  }

  function render() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const w = canvas.width / dpr;
    const h = canvas.height / dpr;

    ctx.clearRect(0, 0, w, h);

    if (entering) {
      drawChicken(chicken.x, chicken.y);
      drawEffects();
      return;
    }

    if (cageActive) {
      drawChicken(chickenCaughtX, chickenCaughtY);
      drawCage(
        chickenCaughtX + chicken.width / 2,
        chickenCaughtY + chicken.height / 2 + getBobOffset(),
        getCageProgress()
      );
      drawEffects();
      return;
    }

    drawChicken(chicken.x, chicken.y);
    drawEffects();
  }

  function gameLoop(now: number) {
    const dtMs = lastFrameTime ? Math.min(32, now - lastFrameTime) : 16.67;
    const dt = dtMs / 1000;
    lastFrameTime = now;
    if (entering) {
      updateEntry();
    } else if (cageActive) {
      updateCage();
    } else {
      updatePhysics(dt);
    }
    updateEffects(dtMs);
    render();
    animId = requestAnimationFrame(gameLoop);
  }

  function startGameLoop() {
    if (animId) cancelAnimationFrame(animId);
    lastFrameTime = 0;
    animId = requestAnimationFrame(gameLoop);
  }

  function stopGame() {
    if (animId) {
      cancelAnimationFrame(animId);
      animId = 0;
    }
    entering = false;
    cageActive = false;
    effects.length = 0;
  }

  async function openGame() {
    if (motionState !== 'closed') return;
    const version = ++transitionVersion;
    motionState = 'opening';
    cancelMotion();
    Object.assign(heroChicken.style, {
      display: 'none',
      opacity: '1',
      transform: 'none',
      visibility: 'visible'
    });
    panel!.style.clipPath = reduceMotion.matches ? 'inset(0)' : 'inset(0 0 0 100%)';
    score = 0;
    streak = 0;
    updateHud();

    entryRect = tabThumb.getBoundingClientRect();
    heroChicken.src = spriteSrc;
    placeHero(entryRect);
    tabThumb.style.visibility = 'hidden';
    panel!.style.clipPath = reduceMotion.matches ? 'inset(0)' : 'inset(0 0 0 100%)';
    panel?.classList.add('motion-active', 'expanded');
    gameContainer?.classList.add('expanded');
    isExpanded = true;
    openPanel('game');

    await nextFrame();
    await nextFrame();
    const landingRect = await prepareCanvasForLanding();
    if (version !== transitionVersion || !entryRect) return;

    placeHero(landingRect);
    const duration = reduceMotion.matches ? 0 : 420;
    await Promise.all([
      animateElement(panel, [
        { clipPath: 'inset(0 0 0 100%)' },
        { clipPath: 'inset(0 0 0 0)' }
      ], { duration, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' }),
      animateElement(heroChicken, [
        { transform: heroTransform(entryRect, landingRect), borderRadius: '8px' },
        { transform: `translate3d(${(entryRect.left - landingRect.left) * 0.18}px, ${(entryRect.top - landingRect.top) * 0.18 - 18}px, 0) scale(1.08) rotate(-3deg)`, borderRadius: '10px', offset: 0.72 },
        { transform: 'none', borderRadius: '8px' }
      ], { duration: reduceMotion.matches ? 0 : 500, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' })
    ]);
    if (version !== transitionVersion) return;

    panel!.style.clipPath = 'inset(0 0 0 0)';
    heroChicken.style.transform = 'none';
    heroChicken.style.opacity = '1';
    render();
    heroChicken.style.display = 'none';
    cancelMotion();
    panel!.style.clipPath = '';
    panel?.classList.remove('motion-active');
    startGameLoop();
    updateHud();
    motionState = 'open';
  }

  async function closeGame() {
    if (motionState === 'closed' || motionState === 'closing') return;
    const version = ++transitionVersion;

    const computedClip = panel ? getComputedStyle(panel).clipPath : 'inset(0 0 0 0)';
    panel!.style.clipPath = computedClip === 'none' ? 'inset(0 0 0 0)' : computedClip;
    cancelMotion();
    motionState = 'closing';
    isExpanded = false;
    tabThumb.style.visibility = 'hidden';
    heroChicken.style.display = 'none';
    heroChicken.style.opacity = '0';
    heroChicken.style.transform = 'none';
    if (animId) {
      cancelAnimationFrame(animId);
      animId = 0;
    }
    panel?.classList.add('motion-active');
    const duration = reduceMotion.matches ? 0 : 380;
    await animateElement(panel, [
      { clipPath: panel!.style.clipPath },
      { clipPath: 'inset(0 0 0 100%)' }
    ], { duration, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)', fill: 'forwards' });
    if (version !== transitionVersion) return;

    panel!.style.clipPath = 'inset(0 0 0 100%)';
    cancelMotion();
    gameContainer?.classList.remove('expanded');
    panel?.classList.remove('expanded');
    closePanel('game');
    void panel?.offsetWidth;

    stopGame();
    ctx?.clearRect(0, 0, canvas.width, canvas.height);
    heroChicken.style.display = 'none';
    heroChicken.style.opacity = '1';
    heroChicken.style.transform = 'none';
    tabThumb.style.visibility = 'visible';
    panel!.style.clipPath = '';
    panel?.classList.remove('motion-active');
    motionState = 'closed';
  }

  tab?.addEventListener('click', openGame);
  closeTab?.addEventListener('click', closeGame);

  canvas?.addEventListener('click', (e) => {
    if (cageActive || entering || motionState !== 'open') return;
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;
    if (isChickenHit(mx, my)) {
      startCage();
    } else {
      streak = 0;
      addEffect(mx, my, 'miss');
      showCallout('MISS', 'miss');
      updateHud();
    }
  });

  window.addEventListener('resize', () => {
    if (isExpanded && ctx) resizeCanvas();
  });

  const canvasObserver = new ResizeObserver(() => {
    if (isExpanded && ctx) resizeCanvas();
  });
  if (canvas?.parentElement) canvasObserver.observe(canvas.parentElement);

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      if (animId) cancelAnimationFrame(animId);
      animId = 0;
    } else if (motionState === 'open' && ctx && sprite?.complete) {
      startGameLoop();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeGame();
  });

  onPanelClose('game', closeGame);

  document.addEventListener('mousemove', (e) => {
    if (isExpanded) return;
    const isNear = e.clientX > window.innerWidth * 0.7;
    tab?.classList.toggle('hover', isNear);
  });

  fetch('/api/catch')
    .then(res => res.json())
    .then(data => {
      if (catchCount && Number.isFinite(data.count)) {
        catchCount.textContent = data.count.toString();
        count = data.count;
        localStorage.setItem('yousa-catch-count', count.toString());
        updateHud();
      }
    })
    .catch(() => {});

  updateHud();
</script>

