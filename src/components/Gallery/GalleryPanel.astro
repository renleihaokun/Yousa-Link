---
---

<div class="gallery-container" id="gallery-container">
  <div class="gallery-backdrop" id="gallery-backdrop" aria-hidden="true"></div>
  <button class="gallery-tab" id="gallery-tab" type="button" aria-label="打开看看鸢画廊">
    <img class="tab-preview" id="tab-preview" src="" alt="" />
    <span class="tab-arrow" id="tab-arrow">›</span>
    <span class="tab-label">看看鸢</span>
  </button>

  <img class="hero-image" id="hero-image" src="" alt="" />

  <div class="panel-body" id="panel-body">
    <div class="gallery-header">
      <span class="header-arrow">›</span>
      <h2>看看鸢</h2>
    </div>
    <div class="gallery-grid" id="gallery-grid"></div>
  </div>
</div>

<div class="lightbox" id="lightbox" aria-hidden="true">
  <div class="lightbox-overlay" id="lightbox-overlay"></div>
  <button class="lightbox-close" id="lightbox-close" type="button" aria-label="关闭大图">✕</button>
  <button class="lightbox-nav lightbox-prev" id="lightbox-prev" type="button" aria-label="上一张">‹</button>
  <button class="lightbox-nav lightbox-next" id="lightbox-next" type="button" aria-label="下一张">›</button>
  <img class="lightbox-image" id="lightbox-image" src="" alt="" />
</div>

<button class="close-edge" id="close-edge" type="button" aria-label="关闭画廊">
  <span class="close-arrow">‹</span>
</button>

<script>
  import { closePanel, onPanelClose, openPanel } from '../../scripts/panel-controller';

  const container = document.getElementById('gallery-container');
  const backdrop = document.getElementById('gallery-backdrop');
  const tab = document.getElementById('gallery-tab');
  const tabPreview = document.getElementById('tab-preview') as HTMLImageElement;
  const heroImage = document.getElementById('hero-image') as HTMLImageElement;
  const panelBody = document.getElementById('panel-body');
  const grid = document.getElementById('gallery-grid');
  const closeEdge = document.getElementById('close-edge');
  const lightbox = document.getElementById('lightbox');
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxPrev = document.getElementById('lightbox-prev');
  const lightboxNext = document.getElementById('lightbox-next');
  const lightboxOverlay = document.getElementById('lightbox-overlay');

  let sampleImages: string[] = [];
  let galleryImages: string[] = [];
  let lightboxIndex = 0;
  type MotionState = 'closed' | 'opening' | 'open' | 'closing';
  let motionState: MotionState = 'closed';
  let isExpanded = false;
  let previewIndex = -1;
  let transitionVersion = 0;
  let entryRect: DOMRect | null = null;
  let activeAnimations: Animation[] = [];

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const nextFrame = () => new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));

  function cancelElementAnimations(element: Element | null, subtree = false) {
    element?.getAnimations({ subtree }).forEach((animation) => animation.cancel());
  }

  function cancelMotion() {
    activeAnimations.forEach((animation) => animation.cancel());
    activeAnimations = [];
    cancelElementAnimations(heroImage);
    cancelElementAnimations(backdrop);
    cancelElementAnimations(panelBody);
  }

  function cancelGridMotion() {
    cancelElementAnimations(grid, true);
  }

  function animateElement(
    element: Element | null,
    keyframes: Keyframe[],
    options: KeyframeAnimationOptions
  ) {
    if (!element || reduceMotion.matches) return Promise.resolve();
    const animation = element.animate(keyframes, options);
    activeAnimations.push(animation);
    return animation.finished.catch(() => undefined);
  }

  async function loadStickers() {
    try {
      const response = await fetch('/images/stickers.json');
      sampleImages = await response.json();
    } catch {
      console.error('Failed to load stickers.json');
    }
  }

  function shuffleArray<T>(array: T[]): T[] {
    const shuffled = [...array];
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    return shuffled;
  }

  function pickPreview() {
    if (sampleImages.length === 0) return;
    let idx: number;
    do {
      idx = Math.floor(Math.random() * sampleImages.length);
    } while (idx === previewIndex && sampleImages.length > 1);
    previewIndex = idx;
    return sampleImages[idx];
  }

  function updatePreview() {
    const src = pickPreview();
    if (src) tabPreview.src = src;
  }

  function openLightbox(index: number) {
    if (!lightbox || !lightboxImage) return;
    lightboxIndex = index;
    lightboxImage.src = galleryImages[index];
    lightboxImage.alt = `表情包 ${index + 1}`;
    lightbox.classList.add('open');
    lightbox.setAttribute('aria-hidden', 'false');
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove('open');
    lightbox.setAttribute('aria-hidden', 'true');
  }

  function navigateLightbox(direction: number) {
    if (galleryImages.length === 0) return;
    lightboxIndex = (lightboxIndex + direction + galleryImages.length) % galleryImages.length;
    lightboxImage.src = galleryImages[lightboxIndex];
    lightboxImage.alt = `表情包 ${lightboxIndex + 1}`;
  }

  function getColumnCount(): number {
    const w = window.innerWidth;
    if (w < 480) return 2;
    if (w < 640) return 3;
    if (w < 860) return 4;
    if (w < 1100) return 5;
    return 6;
  }

  async function loadGallery() {
    if (sampleImages.length === 0) {
      await loadStickers();
    }
    if (sampleImages.length === 0 || !grid) return;

    galleryImages = shuffleArray(sampleImages);
    const columnCount = getColumnCount();

    grid.innerHTML = '';
    galleryImages.forEach((img, index) => {
      const div = document.createElement('div');
      div.className = 'gallery-item';
      div.style.setProperty('--i', String(index));

      const inner = document.createElement('div');
      inner.className = 'gallery-inner';

      const col = index % columnCount;
      const isEdge = col === 0 || col === columnCount - 1;
      const maxTilt = isEdge ? 1.5 : 4;
      const tilt = (Math.random() - 0.5) * 2 * maxTilt;
      inner.style.setProperty('--tilt', `${tilt}deg`);

      const imgEl = document.createElement('img');
      imgEl.alt = `表情包 ${index + 1}`;
      imgEl.loading = 'lazy';
      imgEl.decoding = 'async';
      imgEl.src = img;
      imgEl.addEventListener('click', () => openLightbox(index));

      inner.appendChild(imgEl);
      div.appendChild(inner);
      grid.appendChild(div);
    });
  }

  function placeHero(rect: DOMRect) {
    Object.assign(heroImage.style, {
      display: 'block',
      position: 'fixed',
      left: `${rect.left}px`,
      top: `${rect.top}px`,
      width: `${rect.width}px`,
      height: `${rect.height}px`,
      borderRadius: '10px',
      transform: 'none',
      transformOrigin: 'top left',
      opacity: '1',
      zIndex: '302',
      pointerEvents: 'none',
      transition: 'none'
    });
  }

  function heroTransform(from: DOMRect, to: DOMRect) {
    return `translate3d(${from.left - to.left}px, ${from.top - to.top}px, 0) scale(${from.width / to.width}, ${from.height / to.height})`;
  }

  function getHeroTargetRect() {
    const naturalWidth = heroImage.naturalWidth || tabPreview.naturalWidth;
    const naturalHeight = heroImage.naturalHeight || tabPreview.naturalHeight;
    const ratio = naturalWidth && naturalHeight ? naturalWidth / naturalHeight : 1;
    const maxWidth = Math.min(window.innerWidth * 0.7, 760);
    const maxHeight = window.innerHeight * 0.65;
    let width = maxWidth;
    let height = width / ratio;
    if (height > maxHeight) {
      height = maxHeight;
      width = height * ratio;
    }
    return new DOMRect(
      (window.innerWidth - width) / 2,
      (window.innerHeight - height) / 2,
      width,
      height
    );
  }

  async function closeGallery() {
    if (motionState === 'closed' || motionState === 'closing') return;
    const version = ++transitionVersion;

    const panelStyle = panelBody ? getComputedStyle(panelBody) : null;
    const backdropStyle = backdrop ? getComputedStyle(backdrop) : null;
    if (panelBody && panelStyle) {
      panelBody.style.opacity = panelStyle.opacity;
      panelBody.style.transform = panelStyle.transform === 'none' ? 'none' : panelStyle.transform;
    }
    if (backdrop && backdropStyle) {
      backdrop.style.clipPath = backdropStyle.clipPath === 'none'
        ? 'inset(0 0 0 0)'
        : backdropStyle.clipPath;
    }
    cancelMotion();
    grid?.querySelectorAll<HTMLElement>('.gallery-item').forEach((item) => {
      item.style.opacity = '1';
      item.style.transform = 'translateY(0)';
    });
    cancelGridMotion();
    motionState = 'closing';
    isExpanded = false;
    closeLightbox();
    container?.classList.add('motion-active', 'is-closing');
    container?.classList.remove('is-opening');

    tabPreview.style.visibility = 'hidden';
    heroImage.style.display = 'none';
    heroImage.style.opacity = '0';

    const duration = reduceMotion.matches ? 0 : 380;
    const panelOpacity = panelBody?.style.opacity || '1';
    const panelTransform = panelBody?.style.transform || 'none';
    const backdropClip = backdrop?.style.clipPath || 'inset(0 0 0 0)';
    const animations = [
      animateElement(panelBody, [
        { opacity: panelOpacity, transform: panelTransform },
        { opacity: 0, transform: 'translate3d(-12px, 0, 0)' }
      ], { duration: Math.min(duration, 240), easing: 'ease', fill: 'forwards' }),
      animateElement(backdrop, [
        { clipPath: backdropClip },
        { clipPath: 'inset(0 100% 0 0)' }
      ], { duration, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)', fill: 'forwards' })
    ];

    await Promise.all(animations);
    if (version !== transitionVersion) return;

    panelBody!.style.opacity = '0';
    panelBody!.style.transform = 'translate3d(-12px, 0, 0)';
    backdrop!.style.clipPath = 'inset(0 100% 0 0)';
    cancelMotion();
    panelBody!.style.display = 'none';
    container?.classList.remove('expanded', 'is-closing');
    closePanel('gallery');
    void container?.offsetWidth;

    heroImage.style.display = 'none';
    heroImage.style.opacity = '0';
    heroImage.style.transform = 'none';
    tabPreview.style.visibility = 'visible';
    tabPreview.style.opacity = '';
    grid!.innerHTML = '';
    cancelGridMotion();
    container?.classList.remove('motion-active', 'hover');
    motionState = 'closed';
  }

  document.addEventListener('mousemove', (e) => {
    if (isExpanded) return;
    const isNear = e.clientX < window.innerWidth * 0.2;
    container?.classList.toggle('hover', isNear);
    if (isNear && sampleImages.length > 0 && !tabPreview.getAttribute('src')) {
      updatePreview();
    }
  });

  tab?.addEventListener('click', async () => {
    if (motionState !== 'closed') return;
    const version = ++transitionVersion;
    motionState = 'opening';
    cancelMotion();
    cancelGridMotion();
    grid!.innerHTML = '';
    galleryImages = [];
    Object.assign(heroImage.style, {
      display: 'none',
      opacity: '1',
      transform: 'none',
      visibility: 'visible'
    });
    Object.assign(panelBody!.style, {
      display: 'none',
      opacity: '0',
      transform: 'translate3d(0, 12px, 0)'
    });
    if (backdrop) backdrop.style.clipPath = 'inset(0 100% 0 0)';

    if (sampleImages.length === 0) await loadStickers();
    if (!tabPreview.getAttribute('src')) updatePreview();
    const selectedImage = tabPreview.getAttribute('src') || '';
    if (!selectedImage) {
      motionState = 'closed';
      return;
    }

    entryRect = tabPreview.getBoundingClientRect();
    heroImage.src = selectedImage;
    if (version !== transitionVersion || !entryRect) return;

    container?.classList.add('motion-active', 'expanded', 'is-opening');
    isExpanded = true;
    openPanel('gallery');
    panelBody!.style.display = 'flex';
    panelBody!.style.opacity = '0';
    await nextFrame();
    await nextFrame();
    if (version !== transitionVersion) return;

    const targetRect = getHeroTargetRect();
    if (targetRect.width === 0) {
      panelBody!.style.opacity = '1';
      motionState = 'open';
      container?.classList.remove('motion-active', 'is-opening');
      return;
    }

    placeHero(targetRect);
    tabPreview.style.visibility = 'hidden';
    const duration = reduceMotion.matches ? 0 : 420;
    const startTransform = heroTransform(entryRect, targetRect);

    await Promise.all([
      animateElement(backdrop, [
        { clipPath: 'inset(0 100% 0 0)' },
        { clipPath: 'inset(0 0 0 0)' }
      ], { duration, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' }),
      animateElement(heroImage, [
        { transform: startTransform, borderRadius: '8px' },
        { transform: 'none', borderRadius: '10px' }
      ], { duration, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' })
    ]);
    if (version !== transitionVersion) return;

    backdrop!.style.clipPath = 'inset(0 0 0 0)';
    heroImage.style.transform = 'none';
    heroImage.style.opacity = '1';
    heroImage.style.borderRadius = '10px';
    cancelMotion();

    if (!reduceMotion.matches) await new Promise<void>((resolve) => setTimeout(resolve, 120));
    if (version !== transitionVersion) return;

    await loadGallery();
    await nextFrame();
    if (version !== transitionVersion) return;

    await Promise.all([
      animateElement(heroImage, [
        { opacity: 1, transform: 'none' },
        { opacity: 0, transform: 'scale(0.98)' }
      ], { duration: reduceMotion.matches ? 0 : 220, easing: 'ease', fill: 'forwards' }),
      animateElement(panelBody, [
        { opacity: 0, transform: 'translate3d(0, 12px, 0)' },
        { opacity: 1, transform: 'translate3d(0, 0, 0)' }
      ], { duration: reduceMotion.matches ? 0 : 220, easing: 'ease', fill: 'forwards' })
    ]);
    if (version !== transitionVersion) return;

    heroImage.style.opacity = '0';
    heroImage.style.transform = 'scale(0.98)';
    heroImage.style.display = 'none';
    panelBody!.style.opacity = '1';
    panelBody!.style.transform = 'none';
    cancelMotion();
    container?.classList.remove('motion-active', 'is-opening');
    motionState = 'open';
  });

  closeEdge?.addEventListener('click', closeGallery);

  lightboxClose?.addEventListener('click', closeLightbox);
  lightboxOverlay?.addEventListener('click', closeLightbox);
  lightboxPrev?.addEventListener('click', () => navigateLightbox(-1));
  lightboxNext?.addEventListener('click', () => navigateLightbox(1));

  document.addEventListener('keydown', (e) => {
    if (lightbox?.classList.contains('open')) {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') navigateLightbox(-1);
      if (e.key === 'ArrowRight') navigateLightbox(1);
    } else if (e.key === 'Escape') {
      closeGallery();
    }
  });

  let swipeStartX = 0;
  lightbox?.addEventListener('touchstart', (event) => {
    swipeStartX = event.changedTouches[0]?.clientX ?? 0;
  }, { passive: true });
  lightbox?.addEventListener('touchend', (event) => {
    const endX = event.changedTouches[0]?.clientX ?? swipeStartX;
    const distance = endX - swipeStartX;
    if (Math.abs(distance) > 48) navigateLightbox(distance > 0 ? -1 : 1);
  }, { passive: true });

  onPanelClose('gallery', closeGallery);

  loadStickers().then(updatePreview);
</script>

<style is:global>
  body.panel-open {
    overflow: hidden;
  }

  .gallery-container {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 60px;
    z-index: 150;
    cursor: pointer;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 105, 180, 0.3);
    border-left: none;
    transition:
      width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      top 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      border-radius 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      background 0.4s ease,
      left 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      opacity var(--duration-fast) ease;
  }

  .gallery-container.hover {
    width: 180px;
  }

  .gallery-backdrop {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #a4d3eb;
    pointer-events: none;
    clip-path: inset(0);
  }

  .gallery-container.expanded .gallery-backdrop {
    display: block;
  }

  .gallery-container.motion-active {
    transition: none;
  }

  .gallery-container.expanded {
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    transform: none;
    border-radius: 0;
    background: transparent;
    z-index: 300;
  }

  .gallery-container.expanded .panel-body {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    padding: max(28px, var(--safe-top)) 40px 40px;
    z-index: 1;
  }

  .gallery-tab {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 20px 10px;
    gap: 10px;
    transition: opacity 0.2s ease;
    width: 100%;
    border: 0;
    color: inherit;
    background: transparent;
    cursor: pointer;
  }

  .gallery-container.expanded .gallery-tab {
    opacity: 0;
    pointer-events: none;
  }

  .tab-preview {
    width: 0;
    height: 0;
    object-fit: contain;
    border-radius: 8px;
    opacity: 0;
    transition: width 0.3s ease, height 0.3s ease, opacity 0.3s ease;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.5);
  }

  .gallery-container.hover .tab-preview {
    width: 96px;
    height: 96px;
    opacity: 1;
  }

  .tab-arrow {
    font-size: 26px;
    color: var(--color-pink);
    flex-shrink: 0;
    padding: 4px;
  }

  .hero-image {
    position: fixed;
    display: none;
    z-index: 301;
    object-fit: contain;
    pointer-events: none;
  }

  .panel-body {
    display: none;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: max(28px, var(--safe-top)) 40px 40px;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .close-edge {
    position: fixed;
    right: 0;
    top: 50%;
    transform: translate(12px, -50%);
    z-index: 400;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
    padding: 26px 12px;
    border-radius: var(--radius-md) 0 0 var(--radius-md);
    border: 1px solid rgba(255, 105, 180, 0.3);
    border-right: none;
    transition: opacity 0.3s ease, transform var(--duration-medium) var(--ease-standard), padding var(--duration-fast) ease, background var(--duration-fast) ease;
    opacity: 0;
    pointer-events: none;
    display: flex;
    align-items: center;
  }

  .gallery-container.expanded ~ .close-edge {
    opacity: 1;
    pointer-events: auto;
    transform: translate(0, -50%);
  }

  .close-edge:hover {
    background: rgba(255, 105, 180, 0.2);
    padding-left: 16px;
  }

  .close-arrow {
    font-size: 26px;
    color: var(--color-pink);
  }

  .gallery-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    flex-shrink: 0;
  }

  .header-arrow {
    font-size: 24px;
    color: var(--color-pink);
    font-weight: 300;
  }

  .gallery-header h2 {
    font-size: 24px;
    font-weight: 700;
    color: #222;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    row-gap: 26px;
    column-gap: 30px;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 4px;
  }

  .gallery-grid::-webkit-scrollbar {
    display: none;
  }

  .gallery-item {
    min-width: 0;
    padding-bottom: 100%;
    height: 0;
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    background: rgba(0, 0, 0, 0.03);
    animation: fadeInUp 0.4s ease both;
    animation-delay: calc(var(--i) * 25ms);
  }

  .gallery-item::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: rgba(255, 255, 255, 0.55);
    border: 2px solid rgba(255, 105, 180, 0.15);
    border-radius: 12px;
    transform: rotate(2deg);
  }

  .gallery-item:hover {
    box-shadow: 0 0 0 2px rgba(255, 105, 180, 0.5);
  }

  .gallery-inner {
    position: absolute;
    top: 6px;
    left: 6px;
    right: 6px;
    bottom: 6px;
    z-index: 1;
    border-radius: 10px;
    overflow: hidden;
    transform: rotate(var(--tilt, 0deg));
  }

  .gallery-inner img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    border: 2px solid rgba(255, 105, 180, 0.25);
    border-radius: 10px;
    background: #fff;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .lightbox {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    z-index: 500;
    align-items: center;
    justify-content: center;
  }

  .lightbox-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
  }

  .lightbox-image {
    position: relative;
    max-width: 85vw;
    max-height: 85vh;
    object-fit: contain;
    z-index: 1;
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
  }

  .lightbox-close {
    position: absolute;
    top: 24px;
    right: 24px;
    z-index: 2;
    background: none;
    border: none;
    font-size: 32px;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition: color 0.2s;
  }

  .lightbox-close:hover {
    color: #fff;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    font-size: 48px;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast) ease, background var(--duration-fast) ease;
    line-height: 1;
  }

  .lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
  }

  .lightbox-prev {
    left: 24px;
  }

  .lightbox-next {
    right: 24px;
  }

  .lightbox.open {
    display: flex;
    animation: lightbox-in var(--duration-fast) ease both;
  }

  @keyframes lightbox-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .gallery-tab .tab-label {
    display: none;
    color: #20242b;
    font-size: 12px;
