---
---

<div class="gallery-container" id="gallery-container">
  <div class="gallery-tab" id="gallery-tab">
    <img class="tab-preview" id="tab-preview" src="" alt="" />
    <span class="tab-arrow" id="tab-arrow">›</span>
  </div>

  <img class="hero-image" id="hero-image" src="" alt="" />

  <div class="panel-body" id="panel-body">
    <div class="gallery-header">
      <span class="header-arrow">›</span>
      <h2>看看鸢</h2>
    </div>
    <div class="gallery-grid" id="gallery-grid"></div>
  </div>
</div>

<div class="lightbox" id="lightbox">
  <div class="lightbox-overlay" id="lightbox-overlay"></div>
  <button class="lightbox-close" id="lightbox-close">✕</button>
  <button class="lightbox-nav lightbox-prev" id="lightbox-prev">‹</button>
  <button class="lightbox-nav lightbox-next" id="lightbox-next">›</button>
  <img class="lightbox-image" id="lightbox-image" src="" alt="" />
</div>

<div class="close-edge" id="close-edge">
  <span class="close-arrow">‹</span>
</div>

<script>
  const container = document.getElementById('gallery-container');
  const tab = document.getElementById('gallery-tab');
  const tabPreview = document.getElementById('tab-preview') as HTMLImageElement;
  const heroImage = document.getElementById('hero-image') as HTMLImageElement;
  const panelBody = document.getElementById('panel-body');
  const grid = document.getElementById('gallery-grid');
  const closeEdge = document.getElementById('close-edge');
  const lightbox = document.getElementById('lightbox');
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxPrev = document.getElementById('lightbox-prev');
  const lightboxNext = document.getElementById('lightbox-next');
  const lightboxOverlay = document.getElementById('lightbox-overlay');

  let sampleImages: string[] = [];
  let galleryImages: string[] = [];
  let lightboxIndex = 0;
  let isExpanded = false;
  let previewIndex = -1;

  async function loadStickers() {
    try {
      const response = await fetch('/images/stickers.json');
      sampleImages = await response.json();
    } catch {
      console.error('Failed to load stickers.json');
    }
  }

  function shuffleArray<T>(array: T[]): T[] {
    const shuffled = [...array];
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    return shuffled;
  }

  function pickPreview() {
    if (sampleImages.length === 0) return;
    let idx: number;
    do {
      idx = Math.floor(Math.random() * sampleImages.length);
    } while (idx === previewIndex && sampleImages.length > 1);
    previewIndex = idx;
    return sampleImages[idx];
  }

  function updatePreview() {
    const src = pickPreview();
    if (src) tabPreview.src = src;
  }

  function openLightbox(index: number) {
    if (!lightbox || !lightboxImage) return;
    lightboxIndex = index;
    lightboxImage.src = galleryImages[index];
    lightboxImage.alt = `表情包 ${index + 1}`;
    lightbox.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.style.display = 'none';
    document.body.style.overflow = '';
  }

  function navigateLightbox(direction: number) {
    if (galleryImages.length === 0) return;
    lightboxIndex = (lightboxIndex + direction + galleryImages.length) % galleryImages.length;
    lightboxImage.src = galleryImages[lightboxIndex];
    lightboxImage.alt = `表情包 ${lightboxIndex + 1}`;
  }

  function getColumnCount(): number {
    const w = window.innerWidth;
    if (w < 480) return 2;
    if (w < 640) return 3;
    if (w < 860) return 4;
    if (w < 1100) return 5;
    return 6;
  }

  async function loadGallery() {
    if (sampleImages.length === 0) {
      await loadStickers();
    }
    if (sampleImages.length === 0 || !grid) return;

    galleryImages = shuffleArray(sampleImages);
    const columnCount = getColumnCount();

    grid.innerHTML = '';
    galleryImages.forEach((img, index) => {
      const div = document.createElement('div');
      div.className = 'gallery-item';
      div.style.setProperty('--i', String(index));

      const inner = document.createElement('div');
      inner.className = 'gallery-inner';

      const col = index % columnCount;
      const isEdge = col === 0 || col === columnCount - 1;
      const maxTilt = isEdge ? 1.5 : 4;
      const tilt = (Math.random() - 0.5) * 2 * maxTilt;
      inner.style.setProperty('--tilt', `${tilt}deg`);

      const imgEl = document.createElement('img');
      imgEl.alt = `表情包 ${index + 1}`;
      imgEl.loading = 'lazy';
      imgEl.src = img;
      imgEl.addEventListener('click', () => openLightbox(index));

      inner.appendChild(imgEl);
      div.appendChild(inner);
      grid.appendChild(div);
    });
  }

  function closeGallery() {
    if (!isExpanded) return;
    isExpanded = false;

    if (galleryImages.length > 0) {
      const idx = Math.floor(Math.random() * galleryImages.length);
      tabPreview.src = galleryImages[idx];
    }
    tabPreview.style.width = '72px';
    tabPreview.style.height = '72px';
    tabPreview.style.opacity = '1';

    panelBody!.style.transition = 'opacity 0.2s ease';
    panelBody!.style.opacity = '0';

    setTimeout(() => {
      panelBody!.style.display = 'none';
      panelBody!.style.transition = '';
      container?.classList.remove('expanded');
      document.body.classList.remove('panel-open');
    }, 150);

    setTimeout(() => {
      tabPreview.style.opacity = '0';
      tabPreview.style.width = '0';
      tabPreview.style.height = '0';

      setTimeout(() => {
        tabPreview.style.opacity = '';
        tabPreview.style.width = '';
        tabPreview.style.height = '';
        tabPreview.src = '';
        grid!.innerHTML = '';
        heroImage.style.display = 'none';
        heroImage.style.opacity = '';
        heroImage.style.transition = '';
        container?.classList.remove('hover');
      }, 350);
    }, 150 + 500);
  }

  document.addEventListener('mousemove', (e) => {
    if (isExpanded) return;
    const isNear = e.clientX < window.innerWidth * 0.2;
    container?.classList.toggle('hover', isNear);
    if (isNear && sampleImages.length > 0 && !tabPreview.getAttribute('src')) {
      updatePreview();
    }
  });

  tab?.addEventListener('click', async () => {
    if (isExpanded) return;
    if (sampleImages.length === 0) {
      await loadStickers();
      updatePreview();
    }
    if (!tabPreview.getAttribute('src')) updatePreview();
    isExpanded = true;

    const rect = tabPreview.getBoundingClientRect();
    heroImage.src = tabPreview.src;

    heroImage.style.display = 'block';
    heroImage.style.position = 'fixed';
    heroImage.style.left = rect.left + 'px';
    heroImage.style.top = rect.top + 'px';
    heroImage.style.width = rect.width + 'px';
    heroImage.style.height = rect.height + 'px';
    heroImage.style.borderRadius = '8px';
    heroImage.style.zIndex = '301';
    heroImage.style.pointerEvents = 'none';
    heroImage.style.transition = 'none';
    heroImage.style.opacity = '1';

    tabPreview.style.opacity = '0';

    void heroImage.offsetHeight;

    const maxW = window.innerWidth * 0.7;
    const maxH = window.innerHeight * 0.7;
    const targetLeft = (window.innerWidth - maxW) / 2;
    const targetTop = (window.innerHeight - maxH) / 2;

    heroImage.style.transition = 'all 0.5s cubic-bezier(0.4, 0, 0.2, 1)';
    heroImage.style.left = targetLeft + 'px';
    heroImage.style.top = targetTop + 'px';
    heroImage.style.width = maxW + 'px';
    heroImage.style.height = maxH + 'px';
    heroImage.style.borderRadius = '16px';

    container?.classList.add('expanded');
    document.body.classList.add('panel-open');

    setTimeout(() => {
      if (!isExpanded) return;
      heroImage.style.transition = 'opacity 0.4s ease';
      heroImage.style.opacity = '0';

      panelBody!.style.display = 'flex';
      requestAnimationFrame(() => {
        panelBody!.style.opacity = '1';
      });

      loadGallery();

      setTimeout(() => {
        heroImage.style.display = 'none';
      }, 400);
    }, 1000);
  });

  closeEdge?.addEventListener('click', closeGallery);

  lightboxClose?.addEventListener('click', closeLightbox);
  lightboxOverlay?.addEventListener('click', closeLightbox);
  lightboxPrev?.addEventListener('click', () => navigateLightbox(-1));
  lightboxNext?.addEventListener('click', () => navigateLightbox(1));

  document.addEventListener('keydown', (e) => {
    if (lightbox?.style.display === 'flex') {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') navigateLightbox(-1);
      if (e.key === 'ArrowRight') navigateLightbox(1);
    }
  });

  loadStickers();
</script>

<style is:global>
  body.panel-open {
    overflow: hidden;
  }

  .gallery-container {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    z-index: 150;
    cursor: pointer;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 105, 180, 0.3);
    border-left: none;
    transition:
      width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      top 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      border-radius 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      background 0.4s ease,
      left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .gallery-container.hover {
    width: 140px;
  }

  .gallery-container.expanded {
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    transform: none;
    border-radius: 0;
    background: var(--color-blue-95);
    backdrop-filter: blur(20px);
    z-index: 300;
  }

  .gallery-container.expanded .panel-body {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    padding: 0 40px 40px;
  }

  .gallery-tab {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 16px 8px;
    gap: 6px;
    transition: opacity 0.2s ease;
  }

  .gallery-container.expanded .gallery-tab {
    opacity: 0;
    pointer-events: none;
  }

  .tab-preview {
    width: 0;
    height: 0;
    object-fit: contain;
    border-radius: 8px;
    opacity: 0;
    transition: all 0.3s ease;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.5);
  }

  .gallery-container.hover .tab-preview {
    width: 72px;
    height: 72px;
    opacity: 1;
  }

  .tab-arrow {
    font-size: 20px;
    color: var(--color-pink);
    flex-shrink: 0;
    padding: 4px;
  }

  .hero-image {
    position: fixed;
    display: none;
    z-index: 301;
    object-fit: contain;
    pointer-events: none;
  }

  .panel-body {
    display: none;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0 40px 40px;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .close-edge {
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 400;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
    padding: 20px 10px;
    border-radius: var(--radius-md) 0 0 var(--radius-md);
    border: 1px solid rgba(255, 105, 180, 0.3);
    border-right: none;
    transition: all 0.3s ease;
    opacity: 0;
    pointer-events: none;
    display: flex;
    align-items: center;
  }

  body.panel-open .close-edge {
    opacity: 1;
    pointer-events: auto;
  }

  .close-edge:hover {
    background: rgba(255, 105, 180, 0.2);
    padding-left: 16px;
  }

  .close-arrow {
    font-size: 20px;
    color: var(--color-pink);
  }

  .gallery-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    flex-shrink: 0;
  }

  .header-arrow {
    font-size: 24px;
    color: var(--color-pink);
    font-weight: 300;
  }

  .gallery-header h2 {
    font-size: 24px;
    font-weight: 700;
    color: #222;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    row-gap: 20px;
    column-gap: 24px;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 4px;
  }

  .gallery-grid::-webkit-scrollbar {
    display: none;
  }

  .gallery-item {
    min-width: 0;
    padding-bottom: 100%;
    height: 0;
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    background: rgba(0, 0, 0, 0.03);
    animation: fadeInUp 0.4s ease both;
    animation-delay: calc(var(--i) * 50ms);
  }

  .gallery-item::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: rgba(255, 255, 255, 0.55);
    border: 2px solid rgba(255, 105, 180, 0.15);
    border-radius: 12px;
    transform: rotate(2deg);
  }

  .gallery-item:hover {
    box-shadow: 0 0 0 2px rgba(255, 105, 180, 0.5);
  }

  .gallery-inner {
    position: absolute;
    top: 6px;
    left: 6px;
    right: 6px;
    bottom: 6px;
    z-index: 1;
    border-radius: 10px;
    overflow: hidden;
    transform: rotate(var(--tilt, 0deg));
  }

  .gallery-inner img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    border: 2px solid rgba(255, 105, 180, 0.25);
    border-radius: 10px;
    background: #fff;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .lightbox {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 500;
    align-items: center;
    justify-content: center;
  }

  .lightbox-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
  }

  .lightbox-image {
    position: relative;
    max-width: 85vw;
    max-height: 85vh;
    object-fit: contain;
    z-index: 1;
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
  }

  .lightbox-close {
    position: absolute;
    top: 24px;
    right: 24px;
    z-index: 2;
    background: none;
    border: none;
    font-size: 32px;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition: color 0.2s;
  }

  .lightbox-close:hover {
    color: #fff;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    font-size: 48px;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    transition: all 0.2s;
    line-height: 1;
  }

  .lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
  }

  .lightbox-prev {
    left: 24px;
  }

  .lightbox-next {
    right: 24px;
  }
</style>
