---
---

<div class="gallery-edge" id="gallery-edge">
  <div class="edge-indicator">
    <span class="edge-text">相册</span>
    <span class="edge-arrow">›</span>
  </div>
</div>

<div class="gallery-panel" id="gallery-panel">
  <div class="gallery-header">
    <h2>相册</h2>
    <button class="close-btn" id="close-gallery">✕</button>
  </div>

  <div class="gallery-grid" id="gallery-grid">
  </div>
</div>

<div class="lightbox" id="lightbox">
  <div class="lightbox-overlay" id="lightbox-overlay"></div>
  <button class="lightbox-close" id="lightbox-close">✕</button>
  <button class="lightbox-nav lightbox-prev" id="lightbox-prev">‹</button>
  <button class="lightbox-nav lightbox-next" id="lightbox-next">›</button>
  <img class="lightbox-image" id="lightbox-image" src="" alt="" />
</div>

<script>
  const edge = document.getElementById('gallery-edge');
  const panel = document.getElementById('gallery-panel');
  const closeBtn = document.getElementById('close-gallery');
  const grid = document.getElementById('gallery-grid');
  const lightbox = document.getElementById('lightbox');
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxPrev = document.getElementById('lightbox-prev');
  const lightboxNext = document.getElementById('lightbox-next');
  const lightboxOverlay = document.getElementById('lightbox-overlay');

  let sampleImages: string[] = [];
  let galleryImages: string[] = [];
  let lightboxIndex = 0;

  async function loadStickers() {
    try {
      const response = await fetch('/images/stickers.json');
      sampleImages = await response.json();
    } catch {
      console.error('Failed to load stickers.json');
    }
  }

  function shuffleArray<T>(array: T[]): T[] {
    const shuffled = [...array];
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    return shuffled;
  }

  function openLightbox(index: number) {
    if (!lightbox || !lightboxImage) return;
    lightboxIndex = index;
    lightboxImage.src = galleryImages[index];
    lightboxImage.alt = `表情包 ${index + 1}`;
    lightbox.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.style.display = 'none';
    document.body.style.overflow = '';
  }

  function navigateLightbox(direction: number) {
    if (galleryImages.length === 0) return;
    lightboxIndex = (lightboxIndex + direction + galleryImages.length) % galleryImages.length;
    lightboxImage.src = galleryImages[lightboxIndex];
    lightboxImage.alt = `表情包 ${lightboxIndex + 1}`;
  }

  function getColumnCount(): number {
    const w = window.innerWidth;
    if (w < 480) return 2;
    if (w < 640) return 3;
    if (w < 860) return 4;
    if (w < 1100) return 5;
    return 6;
  }

  async function loadGallery() {
    if (sampleImages.length === 0) {
      await loadStickers();
    }
    if (sampleImages.length === 0 || !grid) return;

    galleryImages = shuffleArray(sampleImages);
    const columnCount = getColumnCount();

    grid.innerHTML = '';
    galleryImages.forEach((img, index) => {
      const div = document.createElement('div');
      div.className = 'gallery-item';
      div.style.setProperty('--i', String(index));

      const inner = document.createElement('div');
      inner.className = 'gallery-inner';

      const col = index % columnCount;
      const isEdge = col === 0 || col === columnCount - 1;
      const maxTilt = isEdge ? 1.5 : 4;
      const tilt = (Math.random() - 0.5) * 2 * maxTilt;
      inner.style.setProperty('--tilt', `${tilt}deg`);

      const imgEl = document.createElement('img');
      imgEl.alt = `表情包 ${index + 1}`;
      imgEl.loading = 'lazy';
      imgEl.src = img;
      imgEl.addEventListener('click', () => openLightbox(index));

      inner.appendChild(imgEl);
      div.appendChild(inner);
      grid.appendChild(div);
    });
  }

  edge?.addEventListener('click', () => {
    loadGallery();
    panel?.classList.add('expanded');
    document.body.classList.add('panel-open');
  });

  closeBtn?.addEventListener('click', () => {
    panel?.classList.remove('expanded');
    document.body.classList.remove('panel-open');
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightboxOverlay?.addEventListener('click', closeLightbox);
  lightboxPrev?.addEventListener('click', () => navigateLightbox(-1));
  lightboxNext?.addEventListener('click', () => navigateLightbox(1));

  document.addEventListener('keydown', (e) => {
    if (lightbox?.style.display === 'flex') {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') navigateLightbox(-1);
      if (e.key === 'ArrowRight') navigateLightbox(1);
    }
  });
</script>

<style is:global>
  body.panel-open {
    overflow: hidden;
  }

  .gallery-edge {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 150;
    cursor: pointer;
  }

  .edge-indicator {
    background: rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
    padding: 20px 12px;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(255, 105, 180, 0.3);
    border-left: none;
    transition: all 0.3s;
  }

  .edge-indicator:hover {
    background: rgba(255, 105, 180, 0.2);
    padding-right: 16px;
  }

  .edge-text {
    writing-mode: vertical-rl;
    font-size: 14px;
    font-weight: 500;
    color: #333;
  }

  .edge-arrow {
    font-size: 20px;
    color: var(--color-pink);
  }

  .gallery-panel {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: var(--color-blue-95);
    backdrop-filter: blur(20px);
    z-index: 300;
    display: flex;
    flex-direction: column;
    padding: 40px;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-100%);
    transition: all 0.4s ease;
    overflow: hidden;
  }

  .gallery-panel.expanded {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
  }

  .gallery-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
    flex-shrink: 0;
  }

  .gallery-header h2 {
    font-size: 24px;
    font-weight: 700;
    color: #222;
  }

  .close-btn {
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    color: #666;
    transition: color 0.2s;
  }

  .close-btn:hover {
    color: var(--color-pink);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    row-gap: 20px;
    column-gap: 24px;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 4px;
  }

  .gallery-grid::-webkit-scrollbar {
    display: none;
  }

  .gallery-item {
    min-width: 0;
    padding-bottom: 100%;
    height: 0;
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    background: rgba(0, 0, 0, 0.03);
    animation: fadeInUp 0.4s ease both;
    animation-delay: calc(var(--i) * 50ms);
  }

  .gallery-item::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: rgba(255, 255, 255, 0.55);
    border: 2px solid rgba(255, 105, 180, 0.15);
    border-radius: 12px;
    transform: rotate(2deg);
  }

  .gallery-item:hover {
    box-shadow: 0 0 0 2px rgba(255, 105, 180, 0.5);
  }

  .gallery-inner {
    position: absolute;
    top: 6px;
    left: 6px;
    right: 6px;
    bottom: 6px;
    z-index: 1;
    border-radius: 10px;
    overflow: hidden;
    transform: rotate(var(--tilt, 0deg));
  }

  .gallery-inner img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    border: 2px solid rgba(255, 105, 180, 0.25);
    border-radius: 10px;
    background: #fff;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .lightbox {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 500;
    align-items: center;
    justify-content: center;
  }

  .lightbox-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
  }

  .lightbox-image {
    position: relative;
    max-width: 85vw;
    max-height: 85vh;
    object-fit: contain;
    z-index: 1;
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
  }

  .lightbox-close {
    position: absolute;
    top: 24px;
    right: 24px;
    z-index: 2;
    background: none;
    border: none;
    font-size: 32px;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition: color 0.2s;
  }

  .lightbox-close:hover {
    color: #fff;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    font-size: 48px;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    transition: all 0.2s;
    line-height: 1;
  }

  .lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
  }

  .lightbox-prev {
    left: 24px;
  }

  .lightbox-next {
    right: 24px;
  }
</style>
