<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="泠鸢yousa 2026全国巡回LIVE - 鸢轨协议互动网页" />
  <link rel="icon" type="image/x-icon" href="/images/favicon/favicon.ico" />
  <link href="/assets/fonts/fonts.css" rel="stylesheet" />
  <title>羁绊环游地图</title>
</head>
<body>
  <slot />
  <div
    class="browser-notice"
    id="browser-notice"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  ></div>
  <div class="beian-seo" style="display: none;">
    <a href="https://beian.miit.gov.cn/">苏ICP备2026010399号-1</a>
    <a href="https://beian.mps.gov.cn/#/query/webSearch?code=32059002007654">苏公网安备32059002007654号</a>
  </div>
</body>
</html>

<script>
  const notice = document.getElementById('browser-notice');
  const noticeKey = 'yousa-browser-notice-seen-v1';

  if (notice) {
    let hasSeenNotice = false;

    try {
      hasSeenNotice = localStorage.getItem(noticeKey) === '1';
      if (!hasSeenNotice) localStorage.setItem(noticeKey, '1');
    } catch {
      hasSeenNotice = false;
    }

    if (hasSeenNotice) {
      notice.remove();
    } else {
      notice.textContent = '建议使用 Chrome 或 Chromium 内核浏览器访问，以获得最佳体验';
      requestAnimationFrame(() => {
        requestAnimationFrame(() => notice.classList.add('visible'));
      });

      window.setTimeout(() => {
        notice.classList.remove('visible');
        window.setTimeout(() => notice.remove(), 450);
      }, 4000);
    }
  }
</script>

<style is:global>
  @import '../styles/global.css';

  .browser-notice {
    position: fixed;
    left: 50%;
    bottom: max(24px, var(--safe-bottom));
    z-index: 600;
    width: max-content;
    max-width: calc(100vw - 32px);
    padding: 11px 16px;
    transform: translate(-50%, 8px);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    color: rgba(255, 255, 255, 0.92);
    background: rgba(17, 19, 23, 0.84);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.38);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    font-size: 13px;
    line-height: 1.5;
    text-align: center;
    transition:
      opacity 400ms ease,
      transform 400ms var(--ease-standard),
      visibility 0s linear 400ms;
  }

  .browser-notice.visible {
    transform: translate(-50%, 0);
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
  }

  @media (max-width: 767px) {
    .browser-notice {
      bottom: calc(var(--safe-bottom) + 72px);
      width: calc(100vw - 32px);
      padding: 10px 14px;
      font-size: 12px;
    }
  }
</style>
